                        	;*** Read Track 3 **************************************************************
                        
0304:                   _atVAR_WaitTrack3:
0304: 3E01     [ 7]     	ld a, 1
0306: 3D       [11]     	dec a
0307: C28703   [21|21]  	jp nz, _atTrack3Wait
                        
                        
030A:                   _atVAR_Track3Ptr:
