                        	; Z80> ld (iy+7), 16	;Set Volume
0821: CD170E   [17]     	call z_iy_stn
0824: 07                	db 7
0825: 10                	db 16
                        
                        	;Sound ?
                        	; Z80> bit 7-2, b	;-2 Because the byte has been shifted previously.
0826: 327B0E   [30]     	ld (z_a),a
0829: 78       [34]     	ld a,b
082A: E620     [41]     	and 1<<(7-2)
082C: 3A7B0E   [54]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
082F: C23C08   [64|64]  	jp nz, PLY_PS_I_SoundOn
                        	;No Sound ! It means we don't care about the software frequency (manual frequency, arpeggio, pitch).
                        	; Z80> ld ixl, %1001
0832: F5       [75]     	push af
0833: 3E09     [82]     	ld a,%1001
0835: 32770E   [95]     	ld (z_ix),a
0838: F1       [105]    	pop af
0839: C37408   [115]    	jp PLY_PS_I_SkipSoftwareFrequencyCalculation
                        
