03F4: DA1A04   [41|41]  	jp c,ps_second
03F7: 47       [45]     	ld b,a				; B = байт>>2: биты 3-0 громкость, бит 5 питч, бит 4 арпеджио
03F8: E60F     [52]     	and $0F
03FA: C20704   [62|62]  	jp nz,ps_soundon
03FD: 32A709   [75]     	ld (ps_vol),a			; нулевая громкость: звука нет (A = 0)
0400: 3E09     [82]     	ld a,%1001
0402: 32A809   [95]     	ld (ps_ixl),a
0405: 37       [99]     	scf
0406: C9       [109]    	ret
0407:                   ps_soundon:
