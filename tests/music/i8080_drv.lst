                        ; [override arkos_src.asm:973] 				rr l
                        ; [override arkos_src.asm:974] 				srl h
                        ; [override arkos_src.asm:975] 				rr l
                        ; [override arkos_src.asm:976] 				srl h
                        ; [override arkos_src.asm:977] 				rr l
                        ; [override arkos_src.asm:978] 				jr nc,$+3
                        ; [override arkos_src.asm:979] 				inc hl
                        
                        	;Hardware Pitch ?
                        	; Z80> bit 7-2, a
074F: 327B0E   [13]     	ld (z_a),a
