084C: 78       [96]     	ld a,b
084D: E604     [103]    	and 1<<(4-2)
084F: 3A7B0E   [116]    	ld a,(z_a)
0852: CDB808   [133]    	call _atSound_getFrequency
                        	; Z80> ld (iy+0), l	;Code Software Frequency.
0855: 327B0E   [146]    	ld (z_a),a
0858: 7D       [150]    	ld a,l
0859: CD270D   [167]    	call z_iy_sta
085C: 00                	db 0
085D: 3A7B0E   [180]    	ld a,(z_a)
                        	; Z80> ld (iy+1), h
0860: 327B0E   [193]    	ld (z_a),a
0863: 7C       [197]    	ld a,h
0864: CD270D   [214]    	call z_iy_sta
0867: 01                	db 1
0868: 3A7B0E   [227]    	ld a,(z_a)
                        	; Z80> exx 
086B: CD4D0E   [244]    	call z_exx
                        
                        	; Z80> ld e, ixh
086E: F5       [255]    	push af
086F: 3A780E   [268]    	ld a,(z_ix+1)
0872: 5F       [272]    	ld e,a
0873: F1       [282]    	pop af
0874:                   PLY_PS_I_SkipSoftwareFrequencyCalculation:
                        
0874: 46       [ 7]     	ld b, (hl)	;Get Second Byte.
0875: 23       [13]     	inc hl
