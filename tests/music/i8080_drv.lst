068C: 79       [55]     	ld a,c
068D: E640     [62]     	and $40
068F: 3A7B0E   [75]     	ld a,(z_a)
0692: CDB808   [92]     	call _atSound_getFrequency
                        	; Z80> ld (iy+0), l	;Code Frequency.
0695: 327B0E   [105]    	ld (z_a),a
0698: 7D       [109]    	ld a,l
0699: CD270D   [126]    	call z_iy_sta
069C: 00                	db 0
069D: 3A7B0E   [139]    	ld a,(z_a)
                        	; Z80> ld (iy+1), h
06A0: 327B0E   [152]    	ld (z_a),a
06A3: 7C       [156]    	ld a,h
06A4: CD270D   [173]    	call z_iy_sta
06A7: 01                	db 1
06A8: 3A7B0E   [186]    	ld a,(z_a)
                        	; Z80> exx 
