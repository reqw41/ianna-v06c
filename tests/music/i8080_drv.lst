                        ;;; ============================== звук одного канала ==============================
                        ; Вход:  HL = указатель на данные инструмента, D = инвертированная громкость, E = нота,
                        ;        ps_pitch = питч трека (word), ps_sfx = 1, если это эффект.
                        ; Выход: HL = новый указатель (0 = звук эффекта кончился), DE = частота,
                        ;        CY = 1, если частота не считалась (её писать не нужно),
                        ;        ps_vol = байт громкости канала, ps_ixl = биты регистра 7 (бит 3 шум выкл, бит 0 тон выкл).
                        ; ps_ixl ЖИВЁТ МЕЖДУ ВЫЗОВАМИ: на кадре, когда эффект кончился, в R7 идёт значение музыкального
                        ; канала (проверено моделью: иначе расходятся 11 кадров из 6200 на каждой песне).
0386:                   ps_sound:
0386: 7E       [ 7]     	ld a,(hl)
0387: 23       [13]     	inc hl
0388: 1F       [17]     	rra				; бит 0: аппаратный звук?
0389: DAEB03   [27|27]  	jp c,ps_hard
038C: 1F       [31]     	rra				; бит 1: нужен второй байт?
038D: DAB303   [41|41]  	jp c,ps_second
0390: 47       [45]     	ld b,a				; B = байт>>2: биты 3-0 громкость, бит 5 питч, бит 4 арпеджио
0391: E60F     [52]     	and $0F
0393: C2A003   [62|62]  	jp nz,ps_soundon
0396: 32A709   [75]     	ld (ps_vol),a			; нулевая громкость: звука нет (A = 0)
0399: 3E09     [82]     	ld a,%1001
039B: 32A809   [95]     	ld (ps_ixl),a
039E: 37       [99]     	scf
039F: C9       [109]    	ret
03A0:                   ps_soundon:
03A0: 92       [ 4]     	sub d				; кодировать громкость
03A1: D2A503   [14|14]  	jp nc,ps_so1
03A4: AF       [18]     	xor a
03A5:                   ps_so1:
