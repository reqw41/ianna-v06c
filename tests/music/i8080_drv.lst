08AF: 3A770E   [281]    	ld a,(z_ix)
                        	; Z80> res 3, a
08B2: E6F7     [288]    	and $F7
                        ; !!FLAGS res: флаги меняются (Z80 не трогает)
                        	; Z80> ld ixl, a
08B4: 32770E   [301]    	ld (z_ix),a
08B7: C9       [311]    	ret
                        
                        
                        
                        	;Subroutine that =
                        	;If Manual Frequency? (Flag Z off), read frequency (Word) and adds the TrackPitch (DE').
                        	;Else, Auto Frequency.
                        	;	if Arpeggio? = 1 (bit 3 from B), read it (Byte).
                        	;	if Pitch? = 1 (bit 4 from B), read it (Word).
                        	;	Calculate the frequency according to the Note (E) + Arpeggio + TrackPitch (DE').
                        
                        	;HL = Pointer on Instrument data.
                        	;DE'= TrackPitch.
                        
                        	;RET=
                        	;HL = Pointer on Instrument moved forward.
                        	;HL'= Frequency
                        	;	RETURN IN AUXILIARY REGISTERS
08B8:                   _atSound_getFrequency:
08B8: C20209   [10|10]  	jp nz, _atSound_getFrequency_manual
08BB:                   _atSound_calcFrequency:
                        	;Pitch ?
                        	; Z80> bit 5-1, b
08BB: 327B0E   [13]     	ld (z_a),a
08BE: 78       [17]     	ld a,b
08BF: E610     [24]     	and 1<<(5-1)
08C1: 3A7B0E   [37]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
08C4: CADB08   [47|47]  	jp z, _atSound_calcFrequency_noPitch
08C7: 7E       [54]     	ld a, (hl)
08C8: 23       [60]     	inc hl
                        	; Z80> exx 
08C9: CD4D0E   [77]     	call z_exx
08CC: 83       [81]     	add a, e	;If Pitch found, add it directly to the TrackPitch.
08CD: 5F       [85]     	ld e, a
                        	; Z80> exx 
08CE: CD4D0E   [102]    	call z_exx
08D1: 7E       [109]    	ld a, (hl)
08D2: 23       [115]    	inc hl
                        	; Z80> exx 
08D3: CD4D0E   [132]    	call z_exx
08D6: 8A       [136]    	adc a, d
08D7: 57       [140]    	ld d, a
                        	; Z80> exx 
08D8: CD4D0E   [157]    	call z_exx
                        
08DB:                   _atSound_calcFrequency_noPitch:
                        	;Arpeggio ?
08DB: 7B       [ 4]     	ld a, e
                        	; Z80> bit 4-1, b
08DC: 327B0E   [17]     	ld (z_a),a
08DF: 78       [21]     	ld a,b
08E0: E608     [28]     	and 1<<(4-1)
08E2: 3A7B0E   [41]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
08E5: CAF108   [51|51]  	jp z, _atSound_calcFrequency_noArp
08E8: 86       [58]     	add a, (hl)	;Add Arpeggio to Note.
08E9: 23       [64]     	inc hl	; possible overflow?
08EA: FE90     [71]     	cp 144
08EC: DAF108   [81|81]  	jp c, $+1+4
08EF: 3E8F     [88]     	ld a, 143
08F1:                   _atSound_calcFrequency_noArp:
                        	;Frequency calculation.
                        	; Z80> exx 
08F1: CD4D0E   [17]     	call z_exx
08F4: 6F       [21]     	ld l, a
08F5: 2600     [28]     	ld h, 0
08F7: 29       [39]     	add hl, hl
08F8: 015309   [49]     	ld bc, _atLUT_notePeriods
08FB: 09       [60]     	add hl, bc
08FC: 7E       [67]     	ld a, (hl)
08FD: 23       [73]     	inc hl
08FE: 66       [80]     	ld h, (hl)
08FF: 6F       [84]     	ld l, a
0900: 19       [95]     	add hl, de	;Add TrackPitch + InstrumentPitch (if any).
0901: C9       [105]    	ret
                        
0902:                   _atSound_getFrequency_manual:
                        	;Manual Frequency. We read it, no need to read Pitch and Arpeggio.
                        	;However, we add TrackPitch to the read Frequency, and that's all.
0902: 7E       [ 7]     	ld a, (hl)
0903: 23       [13]     	inc hl
                        	; Z80> exx 
0904: CD4D0E   [30]     	call z_exx
0907: 83       [34]     	add a, e	;Add TrackPitch LSB.
0908: 6F       [38]     	ld l, a
                        	; Z80> exx 
0909: CD4D0E   [55]     	call z_exx
090C: 7E       [62]     	ld a, (hl)
090D: 23       [68]     	inc hl
                        	; Z80> exx 
090E: CD4D0E   [85]     	call z_exx
0911: 8A       [89]     	adc a, d	;Add TrackPitch HSB.
0912: 67       [93]     	ld h, a
0913: C9       [103]    	ret
                        
                        
                        
                        	;*** Read and decode track data ************************************************
                        
                        	; Read Track.
                        	; Input:
                        	;	HL=Track Pointer.
                        
                        	; Output:
                        	;	HL = Updated Track Pointer.
                        	;	Carry = 1 => Wait A lines.
                        	;		then A = Wait (0(=256)-127)
                        	;	Carry = 0 => Line not empty.
                        	;	 D = Parameters + Volume.
                        	;	 E = Note
                        	;	 B = Instrument. 0=RST
                        	;	IX = PitchAdd. Only used if Pitch? = 1.
0914:                   _atReadTrack:
0914: 7E       [ 7]     	ld a, (hl)
0915: 23       [13]     	inc hl
                        	; Z80> srl a	;Full Optimisation ? If yes = Note only, no Pitch, no Volume, Same Instrument.
0916: B7       [17]     	or a
0917: 1F       [21]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
0918: DA4909   [31|31]  	jp c, _atReadTrack_FullOptimisation
091B: D620     [38]     	sub 32	;0-31 = Wait.
091D: DA4609   [48|48]  	jp c, _atReadTrack_Wait
0920: C22609   [58|58]  	jp nz, _atReadTrack_NoEscapeCode
0923: 7E       [65]     	ld a, (hl)
0924: 23       [71]     	inc hl
0925: 3C       [75]     	inc a
0926:                   _atReadTrack_NoEscapeCode:
0926: 3D       [ 4]     	dec a	;0 (32-32) = Escape Code for more Notes (parameters will be read)
0927: 5F       [ 8]     	ld e, a	;Save Note.
                        
                        	;Read Parameters
0928:                   _atReadTrack_ReadParameters:
0928: 7E       [ 7]     	ld a, (hl)
0929: 57       [11]     	ld d, a	;Save Parameters.
092A: 23       [17]     	inc hl
092B: 17       [21]     	rla	;Pitch ?
092C: D23F09   [31|31]  	jp nc, _atReadTrack_Pitch_End
092F: 46       [38]     	ld b, (hl)	;Get PitchAdd
                        	; Z80> ld ixl, b
0930: F5       [49]     	push af
0931: 78       [53]     	ld a,b
0932: 32770E   [66]     	ld (z_ix),a
0935: F1       [76]     	pop af
0936: 23       [82]     	inc hl
0937: 46       [89]     	ld b, (hl)
                        	; Z80> ld ixh, b
0938: F5       [100]    	push af
0939: 78       [104]    	ld a,b
093A: 32780E   [117]    	ld (z_ix+1),a
093D: F1       [127]    	pop af
093E: 23       [133]    	inc hl
093F:                   _atReadTrack_Pitch_End:
093F: 17       [ 4]     	rla	;Skip IsNote? flag.
0940: 17       [ 8]     	rla	;New Instrument ?
0941: D0       [13|19]  	ret nc
0942: 46       [20]     	ld b, (hl)
0943: 23       [26]     	inc hl
0944: B7       [30]     	or a	;Remove Carry, as the player interpret it as a Wait command.
0945: C9       [40]     	ret
                        
0946:                   _atReadTrack_Wait:
0946: C620     [ 7]     	add a, 32
0948: C9       [17]     	ret
0949:                   _atReadTrack_FullOptimisation:
                        	;Note only, no Pitch, no Volume, Same Instrument.
0949: 1640     [ 7]     	ld d, %01000000	;[7] Note only.
094B: D601     [14]     	sub 1	;[7]
094D: 5F       [18]     	ld e, a	;[4]
094E: D0       [23|29]  	ret nc	;[5/11]
094F: 5E       [30]     	ld e, (hl)	;[7] Escape Code found (0). Read Note.
0950: 23       [36]     	inc hl	;[6]
0951: B7       [40]     	or a	;[4]
0952: C9       [50]     	ret	;[10]
                        
                        
                        	;*** note/Periods lookup table *************************************************
                        
