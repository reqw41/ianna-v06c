06AE: C9       [213]    	ret
                        
                        
                        
                        
                        	;**********
                        	;Hard Sound
                        	;**********
06AF:                   PLY_PS_Hard:
                        	;We don't set the Volume to 16 now because we may have reached the end of the sound !
                        
                        	; Z80> rr b	;Test Retrig here, it is common to every Hard sounds.
06AF: 327B0E   [13]     	ld (z_a),a
06B2: 78       [17]     	ld a,b
06B3: 1F       [21]     	rra
06B4: 47       [25]     	ld b,a
06B5: 3A7B0E   [38]     	ld a,(z_a)
                        ; !!FLAGS rr: нет Z/S/P (только CY)
06B8: D2CB06   [48|48]  	jp nc, PLY_PS_Hard_NoRetrig
06BB: 3A1305   [61]     	ld a, (_atVAR_Track1InstSpeedCtr + 1)	;Retrig only if it is the first step in this line of Instrument !
06BE: 4F       [65]     	ld c, a
06BF: 3A1C05   [78]     	ld a, (_atVAR_Track1InstSpeed + 1)
06C2: B9       [82]     	cp c
06C3: C2CB06   [92|92]  	jp nz, PLY_PS_Hard_NoRetrig
06C6: 3EFE     [99]     	ld a, _atDEF_R13RetrigValue
06C8: 32CF05   [112]    	ld (_atVAR_R13Lock + 1), a
06CB:                   PLY_PS_Hard_NoRetrig:
                        
                        	;Independant/Loop or Software/Hardware Dependent ?
                        	; Z80> bit 1, b	;We don't shift the bits, so that we can use the same code (Frequency calculation) several times.
06CB: 327B0E   [13]     	ld (z_a),a
06CE: 78       [17]     	ld a,b
06CF: E602     [24]     	and $02
06D1: 3A7B0E   [37]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
06D4: C20408   [47|47]  	jp nz, PLY_PS_Hard_LoopOrIndependent
                        
                        	;Hardware Sound.
                        	; Z80> ld (iy+7), 16	;Set Volume
06D7: CD170E   [64]     	call z_iy_stn
06DA: 07                	db 7
06DB: 10                	db 16
                        	; Z80> ld ixl, %1000	;Sound is always On here (only Independence mode can switch it off).
06DC: F5       [75]     	push af
06DD: 3E08     [82]     	ld a,%1000
06DF: 32770E   [95]     	ld (z_ix),a
06E2: F1       [105]    	pop af
                        
                        	;This code is common to both Software and Hardware Dependent.
06E3: 4E       [112]    	ld c, (hl)	;Get Second Byte.
06E4: 23       [118]    	inc hl
06E5: 79       [122]    	ld a, c	;Get the Hardware Envelope waveform.
06E6: E60F     [129]    	and %1111	;We don't care about the bit 7-4, but we have to clear them, else the waveform might be reset.
06E8: 32E505   [142]    	ld (_atVAR_Reg13), a
                        
                        	; Z80> bit 0, b
06EB: 327B0E   [155]    	ld (z_a),a
06EE: 78       [159]    	ld a,b
06EF: E601     [166]    	and $01
06F1: 3A7B0E   [179]    	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
06F4: CA8B07   [189|189]	jp z, PLY_PS_HardwareDependent
                        
                        	;******************
                        	;Software Dependent
                        	;******************
                        
                        	;Calculate the Software frequency
                        	; Z80> bit 4-2, b	;Manual Frequency ? -2 Because the byte has been shifted previously.
06F7: 327B0E   [202]    	ld (z_a),a
06FA: 78       [206]    	ld a,b
06FB: E604     [213]    	and 1<<(4-2)
06FD: 3A7B0E   [226]    	ld a,(z_a)
0700: CDB808   [243]    	call _atSound_getFrequency
                        	; Z80> ld (iy+0), l	;Code Software Frequency.
0703: 327B0E   [256]    	ld (z_a),a
0706: 7D       [260]    	ld a,l
0707: CD270D   [277]    	call z_iy_sta
070A: 00                	db 0
070B: 3A7B0E   [290]    	ld a,(z_a)
                        	; Z80> ld (iy+1), h
070E: 327B0E   [303]    	ld (z_a),a
0711: 7C       [307]    	ld a,h
0712: CD270D   [324]    	call z_iy_sta
0715: 01                	db 1
0716: 3A7B0E   [337]    	ld a,(z_a)
                        	; Z80> exx 
0719: CD4D0E   [354]    	call z_exx
                        
                        	;Shift the Frequency.
071C: 79       [358]    	ld a, c
071D: 1F       [362]    	rra
071E: 1F       [366]    	rra	;Shift=Shift*4. The shift is inverted in memory (7 - Editor Shift).
071F: E61C     [373]    	and %11100
                        ; [override arkos_src.asm:959] 				ld (PLY_PS_SD_Shift + 1),a
0721: 32870E   [386]    	ld (ply_sd_cnt),a
0724: 78       [390]    	ld a, b	;Used to get the HardwarePitch flag within the second registers set.
                        	; Z80> exx 
0725: CD4D0E   [407]    	call z_exx
                        
                        ; [override arkos_src.asm:963] PLY_PS_SD_Shift 		jr $+2
0728:                   PLY_PS_SD_Shift:
0728: 327B0E   [13]     	ld (z_a),a
072B: 3A870E   [26]     	ld a,(ply_sd_cnt)
072E: 0F       [30]     	rrca
072F: 0F       [34]     	rrca
0730: 2F       [38]     	cpl
0731: E607     [45]     	and 7
0733: 3C       [49]     	inc a
0734: 32890E   [62]     	ld (ply_sd_loop),a
0737:                   ply_sd_l:
