0731: 217807   [113]    	ld hl, ps_pitch+1
0734: 8E       [120]    	adc a, (hl)	; CY от первого add: push/pop/ld hl,nn флаги не трогают
0735: 77       [127]    	ld (hl), a
0736: E1       [137]    	pop hl
0737:                   _atSound_calcFrequency_noPitch:
0737: 78       [ 4]     	ld a, b
0738: E608     [11]     	and $08
073A: 7B       [15]     	ld a, e	; нота (and не трогает A? трогает — поэтому флаг проверяем сразу)
073B: CA4707   [25|25]  	jp z, _atSound_calcFrequency_noArp
073E: 86       [32]     	add a, (hl)	; + арпеджио
073F: 23       [38]     	inc hl
0740: FE90     [45]     	cp 144
0742: DA4707   [55|55]  	jp c, _atSound_calcFrequency_noArp
0745: 3E8F     [62]     	ld a, 143
0747:                   _atSound_calcFrequency_noArp:
0747: 227907   [16]     	ld (ps_iptr), hl
074A: 6F       [20]     	ld l, a
074B: 2600     [27]     	ld h, 0
074D: 29       [38]     	add hl, hl
074E: 11C107   [48]     	ld de, _atLUT_notePeriods
0751: 19       [59]     	add hl, de
0752: 5E       [66]     	ld e, (hl)
0753: 23       [72]     	inc hl
0754: 56       [79]     	ld d, (hl)
0755: 2A7707   [95]     	ld hl, (ps_pitch)
0758: 19       [106]    	add hl, de	; период + TrackPitch (+ питч инструмента)
0759: C9       [116]    	ret
075A:                   _atSound_getFrequency_manual:
075A: 5E       [ 7]     	ld e, (hl)	; ручная частота + TrackPitch
075B: 23       [13]     	inc hl
075C: 56       [20]     	ld d, (hl)
075D: 23       [26]     	inc hl
075E: 227907   [42]     	ld (ps_iptr), hl
0761: 2A7707   [58]     	ld hl, (ps_pitch)
0764: 19       [69]     	add hl, de
0765: C9       [79]     	ret
                        	; ps_sra2: HL >>= 2 арифметически (sra h / rr l дважды)
0766:                   ps_sra2:
0766: 7C       [ 4]     	ld a, h
0767: 17       [ 8]     	rla
0768: 7C       [12]     	ld a, h
0769: 1F       [16]     	rra
076A: 67       [20]     	ld h, a
076B: 7D       [24]     	ld a, l
076C: 1F       [28]     	rra
076D: 6F       [32]     	ld l, a
076E: 7C       [36]     	ld a, h
076F: 17       [40]     	rla
0770: 7C       [44]     	ld a, h
0771: 1F       [48]     	rra
0772: 67       [52]     	ld h, a
0773: 7D       [56]     	ld a, l
0774: 1F       [60]     	rra
0775: 6F       [64]     	ld l, a
0776: C9       [74]     	ret
                        	; ячейки нативного плеера
0777: 0000              ps_pitch:	dw 0	; DE' — TrackPitch
0779: 0000              ps_iptr:	dw 0	; указатель инструмента на время расчёта частоты
077B: 0000              ps_freqp:	dw 0	; IY -> частота канала
077D: 0000              ps_volp:	dw 0	; IY+7 -> громкость канала
077F: 00                ps_ixl:	db 0	; флаги R7 канала
0780: 00                ps_ixh:	db 0	; сохранённая нота
0781: 00                ps_r7:	db 0	; AF' — сборка R7
                        
                        	; Read Track.
                        	; Input:
                        	;	HL=Track Pointer.
                        
                        	; Output:
                        	;	HL = Updated Track Pointer.
                        	;	Carry = 1 => Wait A lines.
                        	;		then A = Wait (0(=256)-127)
                        	;	Carry = 0 => Line not empty.
                        	;	 D = Parameters + Volume.
                        	;	 E = Note
                        	;	 B = Instrument. 0=RST
                        	;	IX = PitchAdd. Only used if Pitch? = 1.
0782:                   _atReadTrack:
0782: 7E       [ 7]     	ld a, (hl)
0783: 23       [13]     	inc hl
                        	; Z80> srl a	;Full Optimisation ? If yes = Note only, no Pitch, no Volume, Same Instrument.
0784: B7       [17]     	or a
0785: 1F       [21]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
0786: DAB707   [31|31]  	jp c, _atReadTrack_FullOptimisation
0789: D620     [38]     	sub 32	;0-31 = Wait.
078B: DAB407   [48|48]  	jp c, _atReadTrack_Wait
078E: C29407   [58|58]  	jp nz, _atReadTrack_NoEscapeCode
0791: 7E       [65]     	ld a, (hl)
0792: 23       [71]     	inc hl
0793: 3C       [75]     	inc a
0794:                   _atReadTrack_NoEscapeCode:
0794: 3D       [ 4]     	dec a	;0 (32-32) = Escape Code for more Notes (parameters will be read)
0795: 5F       [ 8]     	ld e, a	;Save Note.
                        
                        	;Read Parameters
0796:                   _atReadTrack_ReadParameters:
0796: 7E       [ 7]     	ld a, (hl)
0797: 57       [11]     	ld d, a	;Save Parameters.
0798: 23       [17]     	inc hl
0799: 17       [21]     	rla	;Pitch ?
079A: D2AD07   [31|31]  	jp nc, _atReadTrack_Pitch_End
079D: 46       [38]     	ld b, (hl)	;Get PitchAdd
                        	; Z80> ld ixl, b
079E: F5       [49]     	push af
079F: 78       [53]     	ld a,b
07A0: 32E50C   [66]     	ld (z_ix),a
07A3: F1       [76]     	pop af
07A4: 23       [82]     	inc hl
07A5: 46       [89]     	ld b, (hl)
                        	; Z80> ld ixh, b
07A6: F5       [100]    	push af
07A7: 78       [104]    	ld a,b
07A8: 32E60C   [117]    	ld (z_ix+1),a
07AB: F1       [127]    	pop af
07AC: 23       [133]    	inc hl
07AD:                   _atReadTrack_Pitch_End:
07AD: 17       [ 4]     	rla	;Skip IsNote? flag.
07AE: 17       [ 8]     	rla	;New Instrument ?
07AF: D0       [13|19]  	ret nc
07B0: 46       [20]     	ld b, (hl)
07B1: 23       [26]     	inc hl
07B2: B7       [30]     	or a	;Remove Carry, as the player interpret it as a Wait command.
07B3: C9       [40]     	ret
                        
07B4:                   _atReadTrack_Wait:
07B4: C620     [ 7]     	add a, 32
07B6: C9       [17]     	ret
07B7:                   _atReadTrack_FullOptimisation:
                        	;Note only, no Pitch, no Volume, Same Instrument.
07B7: 1640     [ 7]     	ld d, %01000000	;[7] Note only.
07B9: D601     [14]     	sub 1	;[7]
07BB: 5F       [18]     	ld e, a	;[4]
07BC: D0       [23|29]  	ret nc	;[5/11]
07BD: 5E       [30]     	ld e, (hl)	;[7] Escape Code found (0). Read Note.
07BE: 23       [36]     	inc hl	;[6]
07BF: B7       [40]     	or a	;[4]
07C0: C9       [50]     	ret	;[10]
                        
                        
                        	;*** note/Periods lookup table *************************************************
                        
07C1:                   _atLUT_notePeriods:
                        	if atCNF_ZXPT
                        	;					dw 4095,4095,4095,4095,4095,4095,4095,4095,4095,4030,3804,3591
07C1: DC0E070E          	dw 3804, 3591
07C5: 3D0D7F0C          	dw 3389, 3199, 3019, 2850, 2690, 2539, 2397, 2262, 2135, 2015, 1902, 1795
