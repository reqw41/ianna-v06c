0877: E60F     [24]     	and %1111	;We don't care about the bit 7-4, but we have to clear them, else the waveform might be reset.
0879: 32E505   [37]     	ld (_atVAR_Reg13), a
                        
                        	;Calculate the Hardware frequency
                        	; Z80> rr b	;Must shift it to match the expected data of the subroutine.
087C: 327B0E   [50]     	ld (z_a),a
087F: 78       [54]     	ld a,b
0880: 1F       [58]     	rra
0881: 47       [62]     	ld b,a
0882: 3A7B0E   [75]     	ld a,(z_a)
                        	; Z80> rr b
