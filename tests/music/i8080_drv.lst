                        ; --------------------------------------
                        ; zasm: assemble "i8080_drv.asm"
                        ; opts: --8080
                        ; date: 2026-08-30 01:06:45
                        ; --------------------------------------


                        ; Стенд переведённого плеера Arkos на i8080: песня по $C980, эффекты по $D980 (обычная память).
                        ; Каждый кадр: atPlay; out ($FF) = маркер кадра. Через 600 кадров halt.
0100:                   	org $0100
0100: C30301   [10]     	jp start
0000:                   DEMO	equ 0
000A:                   VDP_NY	equ 10
0028:                   MUSIC_ROM_PAGE equ 40
0103:                   start:
0103: F3       [ 4]     	di
0104: 31007F   [14]     	ld sp,$7F00
0107: 1180C9   [24]     	ld de,$C980
010A: CD730A   [41]     	call atInit
010D: 1180D9   [51]     	ld de,$D980
0110: CDE00A   [68]     	call atSfxInit
0113: 210000   [78]     	ld hl,0
0116:                   loop:
0116: E5       [11]     	push hl
0117: CD3F01   [28]     	call atPlay
011A: E1       [38]     	pop hl
011B: 3EFF     [45]     	ld a,$FF
011D: D3FF     [56]     	out ($FF),a
011F: 23       [62]     	inc hl
0120: 7C       [66]     	ld a,h
0121: FE02     [73]     	cp 600/256
0123: C21601   [83|83]  	jp nz,loop
0126: 7D       [87]     	ld a,l
0127: FE58     [94]     	cp 600 & 255
0129: C21601   [104|104]	jp nz,loop
012C: 76       [108]    	halt
                        #include "../../build/tr/arkos.asm"
                        ; ==== arkos_src.asm -> i8080 (z80to8080.py) ====
                        
                        	; ВЕКТОР: org снят — плеер на месте в коде
                        
                        	; Arkos Tracker Player V1.0 - Spectrum / Pentagon version.
                        	;   Code by Targhan/Arkos
                        	;   Speccy port / source re-layout by Grim/Arkos
                        	;
                        	; Compile fine with Pasmo v0.5.4.beta2
                        	; Manual and informations available at http://arkostracker.cpcscene.com/
                        	; I know, I know... I'm a tab-indent-zealot =)
                        
                        	;*** Configuration switches ****************************************************
                        
                        	; Switch between Speccy or Pentagon AY3 Tone table
                        	; 1 = Spectrum / any other value = Pentagon
0001:                   atCNF_ZXPT:	equ 1
                        
                        	; Enable/Disable sound effect support.
                        	; 0 = Disabled / any other value = Enabled
0001:                   atCNF_SFX:	equ 1
                        
                        	; Enable/Disable volume fade support.
                        	; 0 = Disabled / any other value = Enabled
0000:                   atCNF_FADE:	equ 0
                        
                        	;*** Player API ****************************************************************
                        
                        	; Initialize the player
                        	; - Routine: atInit
                        	; - Input:
                        	;	DE = Song data address
                        
                        	; Play one tick of the music
                        	; - Routine: atPlay
                        	; - Output:
                        	;	_All_ CPU registers might be modified.
                        
                        	; Stop all sounds (reset the AY3)
                        	; - Routine: atStop
                        
                        	;*** Optionnal sound effect API ************************************************
                        
                        	; Initialize sound effects
                        	; - Routine: atSfxInit
                        	; - Input:
                        	;	DE = Song data address
                        
                        	; Trigger a sound effect on a channel
                        	; - Routine: atSfxPlay
                        	; - Input:
                        	;	 A = Channel (0,1 or 2)
                        	;	 L = Sound effect number (>0)
                        	;	 H = Volume (0 to 15)
                        	;	 E = Note key (0 to 143)
                        	;	 D = Speed
                        	;	BC = Pitch offset
                        	; If the speed parameter is 0, the original intrument speed is used. Any value between
                        	; 1 and 255 will over-ride the default speed (1 being the fastest).
                        
                        	; Stop any sound effect on a given channel
                        	; - Routine: atSfxStop
                        	; - Input:
                        	;	A = Channel (0,1 or 2)
                        
                        
                        	; Stop sound effect on all the 3 channels.
                        	; - Routine: atSfxStopAll
                        
                        	;*** Optionnal fade API ********************************************************
                        
                        	; Set the amount by which the song volume is decreased.
                        	; - Routine: atFade
                        	; - Input:
                        	;	A = volume decrease (0 = no fade, 15+ = enjoy the silence)
                        
                        
                        	;*** Player mighty code ********************************************************
                        
                        	; Internal constant, do not change
00FE:                   _atDEF_R13RetrigValue:	equ $FE
                        
                        	; Added by utopian to have a simple SFX interface
012D: C3730A   [118]    	jp atInit	;Call Player = Initialise song (DE = Song address).
0130: C33F01   [128]    	jp atPlay	;Call Player + 3 = Play song.
0133: C3CF0A   [138]    	jp atStop	;Call Player + 6 = Stop song.
0136: C3E00A   [148]    	jp atSfxInit	;Call Player + 9 to initialise the sound effect music.
0139: C3F40A   [158]    	jp atSfxPlay	;Call Player + 12 to play an effect
013C: C3E70A   [168]    	jp atSfxStopAll	;Call Player + 15 to stop all sound effects.
                        
                        
013F:                   atPlay:
013F: AF       [ 4]     	xor a
0140: 32DF05   [17]     	ld (_atVAR_digidrum), a	;Reset the Digidrum flag.
                        
                        	; If Speed counter is over, we have to read the Pattern further.
0143:                   _atVAR_SongSpeedCtr:
0143: 3E01     [ 7]     	ld a, 1
0145: 3D       [11]     	dec a
0146: C28C03   [21|21]  	jp nz, _atSetSongSpeedCtr
                        
                        	; Do we have to move to the next song position or continue in the same pattern?
0149:                   _atVAR_patternHeightCtr:
0149: 3E01     [ 7]     	ld a, 1
014B: 3D       [11]     	dec a
014C: C2CA01   [21|21]  	jp nz, _atSetPatternHeightCtr
                        
                        	; Pattern Over. We have to read the Linker.
                        	; Get the Transpositions, if they have changed,
                        	; or detect the Song Ending !
                        
014F:                   _atVAR_Linker:
014F: 210000   [10]     	ld hl, 0
0152: 7E       [17]     	ld a, (hl)
0153: 23       [23]     	inc hl
0154: 1F       [27]     	rra
0155: D25F01   [37|37]  	jp nc, _atSongContinue
                        	; Get the song loop position
0158: 7E       [44]     	ld a, (hl)
0159: 23       [50]     	inc hl
015A: 66       [57]     	ld h, (hl)
015B: 6F       [61]     	ld l, a
015C: 7E       [68]     	ld a, (hl)	; We know the Song won't restart now,
015D: 23       [74]     	inc hl	; so we can skip the first bit.
015E: 1F       [78]     	rra
015F:                   _atSongContinue:
015F: 1F       [ 4]     	rra
0160: D26901   [14|14]  	jp nc, _atKeepTrCh1
0163: 113602   [24]     	ld de, _atVAR_TranspCh1 + 1
                        	; Z80> ldi 
0166: CD450E   [41]     	call z_ldi
0169:                   _atKeepTrCh1:
0169: 1F       [ 4]     	rra
016A: D27301   [14|14]  	jp nc, _atKeepTrCh2
016D: 11BC02   [24]     	ld de, _atVAR_TranspCh2 + 1
                        	; Z80> ldi 
0170: CD450E   [41]     	call z_ldi
0173:                   _atKeepTrCh2:
0173: 1F       [ 4]     	rra
0174: D27D01   [14|14]  	jp nc, _atKeepTrCh3
0177: 114203   [24]     	ld de, _atVAR_TranspCh3 + 1
                        	; Z80> ldi 
017A: CD450E   [41]     	call z_ldi
017D:                   _atKeepTrCh3:
                        	; Get the Tracks addresses.
017D: 11FF01   [10]     	ld de, _atVAR_Track1Ptr + 1
                        	; Z80> ldi 
0180: CD450E   [27]     	call z_ldi
                        	; Z80> ldi 
0183: CD450E   [44]     	call z_ldi
0186: 118502   [54]     	ld de, _atVAR_Track2Ptr + 1
                        	; Z80> ldi 
0189: CD450E   [71]     	call z_ldi
                        	; Z80> ldi 
018C: CD450E   [88]     	call z_ldi
018F: 110B03   [98]     	ld de, _atVAR_Track3Ptr + 1
                        	; Z80> ldi 
0192: CD450E   [115]    	call z_ldi
                        	; Z80> ldi 
0195: CD450E   [132]    	call z_ldi
                        
                        	; Get the Special Track address, if it has changed.
0198: 1F       [136]    	rra
0199: D2A201   [146|146]	jp nc, _atKeepPatternHeight
019C: 11C901   [156]    	ld de, _atVAR_PatternHeight + 1
                        	; Z80> ldi 
019F: CD450E   [173]    	call z_ldi
01A2:                   _atKeepPatternHeight:
01A2: 1F       [ 4]     	rra
01A3: D2B101   [14|14]  	jp nc, _atReplaySpecialTrack
                        	; Load a new special track
01A6: 5E       [21]     	ld e, (hl)
01A7: 23       [27]     	inc hl
01A8: 56       [34]     	ld d, (hl)
01A9: 23       [40]     	inc hl
                        	; Z80> ld (_atVAR_SpecialTrackAddr + 1), de
01AA: E5       [51]     	push hl
01AB: EB       [55]     	ex de,hl
01AC: 22B501   [71]     	ld (_atVAR_SpecialTrackAddr + 1),hl
01AF: EB       [75]     	ex de,hl
01B0: E1       [85]     	pop hl
01B1:                   _atReplaySpecialTrack:
01B1: 225001   [16]     	ld (_atVAR_Linker + 1), hl
01B4:                   _atVAR_SpecialTrackAddr:
01B4: 210000   [10]     	ld hl, 0
01B7: 22D401   [26]     	ld (_atVAR_SpecialTrackPtr + 1), hl
                        
                        	; Reset the SpecialTrack/Tracks line counter.
                        	; We can't rely on the song data, because the
                        	; Pattern Height is not related to the Tracks Height.
01BA: 3E01     [33]     	ld a, 1
01BC: 32CE01   [46]     	ld (_atVAR_WaitSpecialTrack + 1), a
01BF: 32F901   [59]     	ld (_atVAR_WaitTrack1 + 1), a
01C2: 327F02   [72]     	ld (_atVAR_WaitTrack2 + 1), a
01C5: 320503   [85]     	ld (_atVAR_WaitTrack3 + 1), a
                        
01C8:                   _atVAR_PatternHeight:
01C8: 3E01     [ 7]     	ld a, 1
01CA:                   _atSetPatternHeightCtr:
01CA: 324A01   [13]     	ld (_atVAR_patternHeightCtr + 1), a
                        
                        
                        	;*** Read Special Track ********************************************************
                        
01CD:                   _atVAR_WaitSpecialTrack:
01CD: 3E01     [ 7]     	ld a, 1
01CF: 3D       [11]     	dec a
01D0: C2F501   [21|21]  	jp nz, _atSpecialTrackWait
                        
01D3:                   _atVAR_SpecialTrackPtr:
01D3: 210000   [10]     	ld hl, 0
01D6: 7E       [17]     	ld a, (hl)
01D7: 23       [23]     	inc hl
                        	; Z80> srl a	;Data (1) or Wait (0) ?
01D8: B7       [27]     	or a
01D9: 1F       [31]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
01DA: D2F201   [41|41]  	jp nc, _atSpecialTrack_waitCmd	;If Wait, A contains the Wait value.
                        	; Z80> srl a	;Speed (0) or Digidrum (1) ?
01DD: B7       [45]     	or a
01DE: 1F       [49]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
                        	; First, we don't test the Effect Type, but only the Escape Code (=0)
01DF: C2E401   [59|59]  	jp nz, _atSpecialTrackNoEscCode
01E2: 7E       [66]     	ld a, (hl)
01E3: 23       [72]     	inc hl
01E4:                   _atSpecialTrackNoEscCode:
                        	; Now, we test the Effect type, since the Carry didn't change.
01E4: D2ED01   [10|10]  	jp nc, _atSpecialTrack_speedCmd
01E7: 32DF05   [23]     	ld (_atVAR_digidrum), a
01EA: C3F001   [33]     	jp _atSpecialTrack_proceed
01ED:                   _atSpecialTrack_speedCmd:
01ED: 328B03   [13]     	ld (_atVAR_SongSpeed + 1), a
01F0:                   _atSpecialTrack_proceed:
01F0: 3E01     [ 7]     	ld a, 1
01F2:                   _atSpecialTrack_waitCmd:
01F2: 22D401   [16]     	ld (_atVAR_SpecialTrackPtr + 1), hl
01F5:                   _atSpecialTrackWait:
01F5: 32CE01   [13]     	ld (_atVAR_WaitSpecialTrack + 1), a
                        
                        
                        	;*** Read Track 1 **************************************************************
                        
01F8:                   _atVAR_WaitTrack1:
01F8: 3E01     [ 7]     	ld a, 1
01FA: 3D       [11]     	dec a
01FB: C27B02   [21|21]  	jp nz, _atTrack1Wait
                        
                        
01FE:                   _atVAR_Track1Ptr:
01FE: 210000   [10]     	ld hl, 0
0201: CD1409   [27]     	call _atReadTrack
0204: 22FF01   [43]     	ld (_atVAR_Track1Ptr + 1), hl
0207: DA7B02   [53|53]  	jp c, _atTrack1Wait
                        
                        	; No Wait command. Can be a Note and/or Effects.
020A: 7A       [57]     	ld a, d	; Make a copy of the flags+Volume in A, not to temper with the original.
020B: 1F       [61]     	rra	; Volume ? If bit 4 was 1, then volume exists on b3-b0
020C: D21402   [71|71]  	jp nc, _atTrack1_keepVolume
020F: E60F     [78]     	and %1111
0211: 320B05   [91]     	ld (_atVAR_Track1Volume), a
0214:                   _atTrack1_keepVolume:
                        	; Z80> rl d	; New Pitch ?
0214: 327B0E   [13]     	ld (z_a),a
0217: 7A       [17]     	ld a,d
0218: 17       [21]     	rla
0219: 57       [25]     	ld d,a
021A: 3A7B0E   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
021D: D22802   [48|48]  	jp nc, _atTrack1_keepPitch
                        	; Z80> ld (_atVAR_Track1PitchAdd + 1), ix
0220: E5       [59]     	push hl
0221: 2A770E   [75]     	ld hl,(z_ix)
0224: 22CD04   [91]     	ld (_atVAR_Track1PitchAdd + 1),hl
0227: E1       [101]    	pop hl
0228:                   _atTrack1_keepPitch:
                        	; Z80> rl d	; Note ? If no Note, we don't have to test if a new Instrument is here.
0228: 327B0E   [13]     	ld (z_a),a
022B: 7A       [17]     	ld a,d
022C: 17       [21]     	rla
022D: 57       [25]     	ld d,a
022E: 3A7B0E   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
0231: D27902   [48|48]  	jp nc, _atTrack1_keepNote
0234: 7B       [52]     	ld a, e
                        	; Transpose Note according to the Transposition in the Linker.
0235:                   _atVAR_TranspCh1:
0235: C600     [ 7]     	add a, 0
0237: 320A05   [20]     	ld (_atVAR_Track1Note), a
                        	; Reset the TrackPitch.
023A: 210000   [30]     	ld hl, 0
023D: 22CA04   [46]     	ld (_atVAR_Track1Pitch + 1), hl
                        	; New Instrument ?
                        	; Z80> rl d
0240: 327B0E   [59]     	ld (z_a),a
0243: 7A       [63]     	ld a,d
0244: 17       [67]     	rla
0245: 57       [71]     	ld d,a
0246: 3A7B0E   [84]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
0249: DA5802   [94|94]  	jp c, _atTrack1LoadInstrument
                        	; Same Instrument. We recover its address to restart it.
024C:                   _atVAR_Track1InstAddr:
024C: 210000   [10]     	ld hl, 0
024F: 3A1C05   [23]     	ld a, (_atVAR_Track1InstSpeed + 1)
0252: 321305   [36]     	ld (_atVAR_Track1InstSpeedCtr + 1), a
0255: C37602   [46]     	jp _atTrack1SetInstrumentPtr
                        
0258:                   _atTrack1LoadInstrument:	; New Instrument. We have to get its new address, and Speed.
0258: 68       [ 4]     	ld l, b	; H is already set to 0 before.
0259: 29       [15]     	add hl, hl
025A:                   _atVAR_Track1InstrumentLUT:
025A: 010000   [10]     	ld bc, 0
025D: 09       [21]     	add hl, bc
025E: 7E       [28]     	ld a, (hl)	; Get Instrument address.
025F: 23       [34]     	inc hl
0260: 66       [41]     	ld h, (hl)
0261: 6F       [45]     	ld l, a
0262: 7E       [52]     	ld a, (hl)	; Get Instrument speed.
0263: 23       [58]     	inc hl
0264: 321C05   [71]     	ld (_atVAR_Track1InstSpeed + 1), a
0267: 321305   [84]     	ld (_atVAR_Track1InstSpeedCtr + 1), a
026A: 7E       [91]     	ld a, (hl)
026B: B7       [95]     	or a	; Get IsRetrig?. Code it only if different to 0, else next Instruments are going to overwrite it.
026C: CA7202   [105|105]	jp z, $+1+5
026F: 32CF05   [118]    	ld (_atVAR_R13Lock + 1), a	; Poke &FE as previous R13 value
0272: 23       [124]    	inc hl
0273: 224D02   [140]    	ld (_atVAR_Track1InstAddr + 1), hl	; When using the Instrument again, no need to give the Speed, it is skipped.
0276:                   _atTrack1SetInstrumentPtr:
0276: 220D05   [16]     	ld (_atVAR_Track1InstrumentPtr + 1), hl
0279:                   _atTrack1_keepNote:
0279: 3E01     [ 7]     	ld a, 1
027B:                   _atTrack1Wait:
027B: 32F901   [13]     	ld (_atVAR_WaitTrack1 + 1), a
                        
                        
                        	;*** Read Track 2 **************************************************************
                        
027E:                   _atVAR_WaitTrack2:
027E: 3E01     [ 7]     	ld a, 1
0280: 3D       [11]     	dec a
0281: C20103   [21|21]  	jp nz, _atTrack2Wait
                        
                        
0284:                   _atVAR_Track2Ptr:
0284: 210000   [10]     	ld hl, 0
0287: CD1409   [27]     	call _atReadTrack
028A: 228502   [43]     	ld (_atVAR_Track2Ptr + 1), hl
028D: DA0103   [53|53]  	jp c, _atTrack2Wait
                        
                        	; No Wait command. Can be a Note and/or Effects.
                        	; Make a copy of the flags+Volume in A, not to temper with the original.
0290: 7A       [57]     	ld a, d
0291: 1F       [61]     	rra	; Volume ? If bit 4 was 1, then volume exists on b3-b0
0292: D29A02   [71|71]  	jp nc, _atTrack2_keepVolume
0295: E60F     [78]     	and %1111
0297: 326E04   [91]     	ld (_atVAR_Track2Volume), a
029A:                   _atTrack2_keepVolume:
                        	; Z80> rl d	; New Pitch ?
029A: 327B0E   [13]     	ld (z_a),a
029D: 7A       [17]     	ld a,d
029E: 17       [21]     	rla
029F: 57       [25]     	ld d,a
02A0: 3A7B0E   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
02A3: D2AE02   [48|48]  	jp nc, _atTrack2_keepPitch
                        	; Z80> ld (_atVAR_Track2PitchAdd + 1), ix
02A6: E5       [59]     	push hl
02A7: 2A770E   [75]     	ld hl,(z_ix)
02AA: 223004   [91]     	ld (_atVAR_Track2PitchAdd + 1),hl
02AD: E1       [101]    	pop hl
02AE:                   _atTrack2_keepPitch:
                        
                        	; Z80> rl d	; Note ? If no Note, we don't have to test if a new Instrument is here.
02AE: 327B0E   [13]     	ld (z_a),a
02B1: 7A       [17]     	ld a,d
02B2: 17       [21]     	rla
02B3: 57       [25]     	ld d,a
02B4: 3A7B0E   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
02B7: D2FF02   [48|48]  	jp nc, _atTrack2_keepNote
                        
                        	; Transpose Note according to the Transposition in the Linker.
02BA: 7B       [52]     	ld a, e
02BB:                   _atVAR_TranspCh2:
02BB: C600     [ 7]     	add a, 0
02BD: 326D04   [20]     	ld (_atVAR_Track2Note), a
                        	; Reset the TrackPitch.
02C0: 210000   [30]     	ld hl, 0
