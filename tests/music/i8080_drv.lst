                        ; ---------------------------------------------------------------------------
                        ; HL := ix+d, d — байт после call. Бережёт A, флаги, BC, DE. HL — результат.
                        ; (вызывающий сам сохраняет HL, если нужно)
0A14:                   z_ix_hl:
0A14: E3       [19]     	ex (sp),hl		; HL=адрес возврата, (SP)=старый HL (не нужен)
0A15: F5       [30]     	push af
0A16: 7E       [37]     	ld a,(hl)		; d
0A17: 23       [43]     	inc hl
0A18: 22EB0C   [59]     	ld (z_ret),hl
