0A21: CE00     [94]     	adc a,0
0A23: 67       [98]     	ld h,a
0A24: F1       [108]    	pop af
0A25: E3       [127]    	ex (sp),hl		; HL=результат... нет: (SP)=старый HL -> вернём через z_ret
                        	; сейчас HL=старый HL, (SP)=результат. Нам нужно вернуть результат в HL,
                        	; а на стек положить адрес возврата.
0A26: E1       [137]    	pop hl			; HL=результат, стек чист
0A27: E5       [148]    	push hl
0A28: 2AEB0C   [164]    	ld hl,(z_ret)
