0742: 32890E   [58]     	ld (ply_sd_loop),a
0745: C23707   [68|68]  	jp nz,ply_sd_l
0748: 3A7B0E   [81]     	ld a,(z_a)
074B: D24F07   [91|91]  	jp nc,ply_sd_noinc
074E: 23       [97]     	inc hl
074F:                   ply_sd_noinc:
                        ; [override arkos_src.asm:964] 				srl h
                        ; [override arkos_src.asm:965] 				rr l
                        ; [override arkos_src.asm:966] 				srl h
                        ; [override arkos_src.asm:967] 				rr l
                        ; [override arkos_src.asm:968] 				srl h
                        ; [override arkos_src.asm:969] 				rr l
                        ; [override arkos_src.asm:970] 				srl h
                        ; [override arkos_src.asm:971] 				rr l
