                        #include "../../src/vec/z80rt.asm"
                        ; z80rt.asm — рантайм-хелперы для кода, оттранслированного z80to8080.py.
                        ; Только i8080 (проверяется zasm --8080). Контракт: каждый хелпер бережёт
                        ; HL, BC, DE, A и флаги, кроме явно объявленного результата.
                        ;
                        ; Ячейки (в vec_vars.asm): z_ix, z_iy (2 байта), z_a (1), z_tmp (1), z_ret (2),
                        ; z_af2, z_bc2, z_de2, z_hl2 (2).
                        
                        ; ---------------------------------------------------------------------------
                        ; ld a,(ix+d): вход A=d. Выход A=(ix+d). Флаги сохранены.
0AA8:                   z_ix_rda:
0AA8: E5       [11]     	push hl
0AA9: F5       [22]     	push af
0AAA: 2A4D0D   [38]     	ld hl,(z_ix)
0AAD: 85       [42]     	add a,l
0AAE: 6F       [46]     	ld l,a
0AAF: D2B30A   [56|56]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0AB2: 24       [60]     	inc h
0AB3: F1       [70]     	pop af
0AB4: 7E       [77]     	ld a,(hl)
0AB5: E1       [87]     	pop hl
0AB6: C9       [97]     	ret
                        ; то же, флаги можно портить (после инструкции они мертвы)
0AB7:                   z_ix_rda_nf:
0AB7: E5       [11]     	push hl
0AB8: 2A4D0D   [27]     	ld hl,(z_ix)
0ABB: 85       [31]     	add a,l
0ABC: 6F       [35]     	ld l,a
0ABD: D2C10A   [45|45]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0AC0: 24       [49]     	inc h
0AC1: 7E       [56]     	ld a,(hl)
0AC2: E1       [66]     	pop hl
0AC3: C9       [76]     	ret
0AC4:                   z_iy_rda:
0AC4: E5       [11]     	push hl
0AC5: F5       [22]     	push af
0AC6: 2A4F0D   [38]     	ld hl,(z_iy)
0AC9: 85       [42]     	add a,l
0ACA: 6F       [46]     	ld l,a
0ACB: D2CF0A   [56|56]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0ACE: 24       [60]     	inc h
0ACF: F1       [70]     	pop af
0AD0: 7E       [77]     	ld a,(hl)
0AD1: E1       [87]     	pop hl
0AD2: C9       [97]     	ret
0AD3:                   z_iy_rda_nf:
0AD3: E5       [11]     	push hl
0AD4: 2A4F0D   [27]     	ld hl,(z_iy)
0AD7: 85       [31]     	add a,l
0AD8: 6F       [35]     	ld l,a
0AD9: D2DD0A   [45|45]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0ADC: 24       [49]     	inc h
0ADD: 7E       [56]     	ld a,(hl)
0ADE: E1       [66]     	pop hl
0ADF: C9       [76]     	ret
                        
                        ; ---------------------------------------------------------------------------
                        ; HL := ix+d, d — байт после call. Бережёт A, флаги, BC, DE. HL — результат.
                        ; (вызывающий сам сохраняет HL, если нужно)
0AE0:                   z_ix_hl:
0AE0: E3       [19]     	ex (sp),hl		; HL=адрес возврата, (SP)=старый HL (не нужен)
0AE1: F5       [30]     	push af
