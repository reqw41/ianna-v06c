                        ; чтение строки трека: HL = указатель.
                        ; Выход: HL обновлён; CY = 1 -> ожидание A строк; иначе D = параметры, E = нота,
                        ;        at_rt_instr = номер инструмента, at_rt_pitch = приращение питча.
05AD:                   at_readtrack:
