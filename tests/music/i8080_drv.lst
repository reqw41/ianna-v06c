07E1: E6059105          
07E5: 4105F604          
07E9: AE046B04          
07ED: 2C04F003          
07F1: B7038203          
07F5: 4F032003          	dw 847, 800, 755, 712, 673, 635, 599, 566, 534, 504, 476, 449
07F9: F302C802          
07FD: A1027B02          
0801: 57023602          
0805: 1602F801          
0809: DC01C101          
080D: A8019001          	dw 424, 400, 377, 356, 336, 317, 300, 283, 267, 252, 238, 224
0811: 79016401          
0815: 50013D01          
0819: 2C011B01          
081D: 0B01FC00          
0821: EE00E000          
0825: D400C800          	dw 212, 200, 189, 178, 168, 159, 150, 141, 133, 126, 119, 112
0829: BD00B200          
082D: A8009F00          
0831: 96008D00          
0835: 85007E00          
0839: 77007000          
083D: 6A006400          	dw 106, 100, 94, 89, 84, 79, 75, 71, 67, 63, 59, 56
0841: 5E005900          
0845: 54004F00          
0849: 4B004700          
084D: 43003F00          
0851: 3B003800          
0855: 35003200          	dw 53, 50, 47, 45, 42, 40, 37, 35, 33, 31, 30, 28
0859: 2F002D00          
085D: 2A002800          
0861: 25002300          
0865: 21001F00          
0869: 1E001C00          
086D: 1A001900          	dw 26, 25, 24, 22, 21, 20, 19, 18, 17, 16, 15, 14
0871: 18001600          
0875: 15001400          
0879: 13001200          
087D: 11001000          
0881: 0F000E00          
0885: 0D000C00          	dw 13, 12, 12, 11, 11, 10, 9, 9, 8, 8, 7, 7
0889: 0C000B00          
088D: 0B000A00          
0891: 09000900          
0895: 08000800          
0899: 07000700          
089D: 07000600          	dw 7, 6, 6, 6, 5, 5, 5, 4, 4, 4, 4, 4
08A1: 06000600          
08A5: 05000500          
08A9: 05000400          
08AD: 04000400          
08B1: 04000400          
08B5: 03000300          	dw 3, 3, 3, 3, 3, 2, 2, 2, 2, 2, 2, 2
08B9: 03000300          
