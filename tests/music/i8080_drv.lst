                        	;*** Player controls ***********************************************************
                        
                        	; Initialize player
                        	;  Input:
                        	;	DE = song data address
0A73:                   atInit:
0A73: 210900   [10]     	ld hl, 9	;Skip Header, SampleChannel, YM Clock (DB*3), and Replay Frequency.
0A76: 19       [21]     	add hl, de
                        
0A77: 118B03   [31]     	ld de, _atVAR_SongSpeed + 1
                        	; Z80> ldi 	;Copy Speed.
0A7A: CD450E   [48]     	call z_ldi
0A7D: 4E       [55]     	ld c, (hl)	;Get Instruments chunk size.
0A7E: 23       [61]     	inc hl
0A7F: 46       [68]     	ld b, (hl)
0A80: 23       [74]     	inc hl
0A81: 225B02   [90]     	ld (_atVAR_Track1InstrumentLUT + 1), hl
0A84: 22E102   [106]    	ld (_atVAR_Track2InstrumentLUT + 1), hl
0A87: 226703   [122]    	ld (_atVAR_Track3InstrumentLUT + 1), hl
                        
0A8A: 09       [133]    	add hl, bc	;Skip Instruments to go to the Linker address.
                        	;Get the pre-Linker information of the first pattern.
0A8B: 11C901   [143]    	ld de, _atVAR_PatternHeight + 1
                        	; Z80> ldi 
0A8E: CD450E   [160]    	call z_ldi
0A91: 113602   [170]    	ld de, _atVAR_TranspCh1 + 1
                        	; Z80> ldi 
0A94: CD450E   [187]    	call z_ldi
0A97: 11BC02   [197]    	ld de, _atVAR_TranspCh2 + 1
                        	; Z80> ldi 
0A9A: CD450E   [214]    	call z_ldi
0A9D: 114203   [224]    	ld de, _atVAR_TranspCh3 + 1
                        	; Z80> ldi 
0AA0: CD450E   [241]    	call z_ldi
0AA3: 11B501   [251]    	ld de, _atVAR_SpecialTrackAddr + 1
                        	; Z80> ldi 
0AA6: CD450E   [268]    	call z_ldi
                        	; Z80> ldi 
0AA9: CD450E   [285]    	call z_ldi
0AAC: 225001   [301]    	ld (_atVAR_Linker + 1), hl	;Get the Linker address.
                        
0AAF: 3E01     [308]    	ld a, 1
0AB1: 324401   [321]    	ld (_atVAR_SongSpeedCtr + 1), a
0AB4: 324A01   [334]    	ld (_atVAR_patternHeightCtr + 1), a
                        
0AB7: 3EFF     [341]    	ld a, $ff
0AB9: 32E505   [354]    	ld (_atVAR_Reg13), a
                        
                        	;Set the Instruments pointers to Instrument 0 data (Header has to be skipped).
0ABC: 2A5B02   [370]    	ld hl, (_atVAR_Track1InstrumentLUT + 1)
0ABF: 5E       [377]    	ld e, (hl)
0AC0: 23       [383]    	inc hl
0AC1: 56       [390]    	ld d, (hl)
0AC2: EB       [394]    	ex de, hl
0AC3: 23       [400]    	inc hl	;Skip Instrument 0 Header.
0AC4: 23       [406]    	inc hl
0AC5: 220D05   [422]    	ld (_atVAR_Track1InstrumentPtr + 1), hl
0AC8: 227004   [438]    	ld (_atVAR_Track2InstrumentPtr + 1), hl
0ACB: 22DB03   [454]    	ld (_atVAR_Track3InstrumentPtr + 1), hl
0ACE: C9       [464]    	ret
                        
                        
                        
                        	;Stop the music, cut the channels.
0ACF:                   atStop:
0ACF: 21DE05   [10]     	ld hl, _atVAR_Reg8	; Clear R8,R9 and R10 to zero
0AD2: 010003   [20]     	ld bc, $0300
0AD5: 71       [27]     	ld (hl), c
0AD6: 23       [33]     	inc hl
                        	; Z80> djnz $-2
0AD7: 05       [37]     	dec b
0AD8: C2D50A   [47|47]  	jp nz,$-1-2
                        ; !!FLAGS djnz: dec b меняет Z/S/P
0ADB: 3E3F     [54]     	ld a, %00111111	; Disable Tone and Noise on all channels
0ADD: C35905   [64]     	jp _atAY3Update
                        
                        
                        	;*** Optionnal Sound effect API ************************************************
                        
                        	if atCNF_SFX
                        
                        	;Initialize the Sound Effects.
                        	; DE = SFX Music.
0AE0:                   atSfxInit:
                        	;Find the Instrument Table.
0AE0: 210C00   [10]     	ld hl, 12
0AE3: 19       [21]     	add hl, de
0AE4: 222B0B   [37]     	ld (_atSfxPlay_InstrumentTable + 1), hl
                        
                        	;Clear the three channels of any sound effect.
0AE7:                   atSfxStopAll:
0AE7: 210000   [10]     	ld hl, 0
0AEA: 222705   [26]     	ld (_atVAR_SfxTrack1_instrument + 1), hl
0AED: 228A04   [42]     	ld (_atVAR_SfxTrack2_instrument + 1), hl
0AF0: 22F503   [58]     	ld (_atVAR_SfxTrack3_instrument + 1), hl
0AF3: C9       [68]     	ret
                        
                        
0000:                   _atDEF_SfxOffset_pitch:	equ 0
0010:                   _atDEF_SfxOffset_volume:	equ _atVAR_SfxTrack1_volume		- _atVAR_SfxTrack1_pitch
000F:                   _atDEF_SfxOffset_note:	equ _atVAR_SfxTrack1_note		- _atVAR_SfxTrack1_pitch
0006:                   _atDEF_SfxOffset_instrument:	equ _atVAR_SfxTrack1_instrument		- _atVAR_SfxTrack1_pitch
002B:                   _atDEF_SfxOffset_speed:	equ _atVAR_SfxTrack1_instrumentSpeed	- _atVAR_SfxTrack1_pitch
0022:                   _atDEF_SfxOffset_speedCtr:	equ _atVAR_SfxTrack1_instrumentSpeedCtr	- _atVAR_SfxTrack1_pitch
                        
                        
                        	;Plays a Sound Effects along with the music.
                        	; Input
                        	;	A = No Channel (0,1,2)
                        	;	L = SFX Number (>0)
                        	;	H = Volume (0...F)
                        	;	E = Note (0...143)
                        	;	D = Speed (0 = As original, 1...255 = new Speed (1 is fastest))
                        	;	BC = Inverted Pitch (-#FFFF -> FFFF). 0 is no pitch. The higher the pitch, the lower the sound.
0AF4:                   atSfxPlay:
                        	; Z80> ld ix, _atVAR_SfxTrack1_pitch
0AF4: E5       [11]     	push hl
0AF5: 212005   [21]     	ld hl,_atVAR_SfxTrack1_pitch
0AF8: 22770E   [37]     	ld (z_ix),hl
0AFB: E1       [47]     	pop hl
0AFC: 3D       [51]     	dec a
0AFD: FA130B   [61|61]  	jp m, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack2_pitch
0B00: E5       [72]     	push hl
0B01: 218304   [82]     	ld hl,_atVAR_SfxTrack2_pitch
0B04: 22770E   [98]     	ld (z_ix),hl
0B07: E1       [108]    	pop hl
0B08: CA130B   [118|118]	jp z, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack3_pitch
0B0B: E5       [129]    	push hl
0B0C: 21EE03   [139]    	ld hl,_atVAR_SfxTrack3_pitch
0B0F: 22770E   [155]    	ld (z_ix),hl
0B12: E1       [165]    	pop hl
                        
0B13:                   _atSfxPlay_Selected:
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 1), c	;Set Pitch
0B13: CD550D   [17]     	call z_ix_st_c
0B16: 01                	db _atDEF_SfxOffset_pitch + 1
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 2), b
0B17: CD3E0D   [34]     	call z_ix_st_b
0B1A: 02                	db _atDEF_SfxOffset_pitch + 2
0B1B: 7B       [38]     	ld a, e	;Set Note
                        	; Z80> ld (ix + _atDEF_SfxOffset_note), a
0B1C: CD100D   [55]     	call z_ix_sta
0B1F: 0F                	db _atDEF_SfxOffset_note
0B20: 3E0F     [62]     	ld a, 15	;Set Volume
0B22: 94       [66]     	sub h
                        	; Z80> ld (ix + _atDEF_SfxOffset_volume), a
0B23: CD100D   [83]     	call z_ix_sta
0B26: 10                	db _atDEF_SfxOffset_volume
0B27: 2600     [90]     	ld h, 0	;Set Instrument Address
0B29: 29       [101]    	add hl, hl
0B2A:                   _atSfxPlay_InstrumentTable:
0B2A: 010000   [10]     	ld bc, 0
0B2D: 09       [21]     	add hl, bc
0B2E: 7E       [28]     	ld a, (hl)
0B2F: 23       [34]     	inc hl
0B30: 66       [41]     	ld h, (hl)
0B31: 6F       [45]     	ld l, a
0B32: 7A       [49]     	ld a, d	;Read Speed or use the user's one ?
0B33: B7       [53]     	or a
0B34: C2380B   [63|63]  	jp nz, _atSfxPlay_UserSpeed
0B37: 7E       [70]     	ld a, (hl)	;Get Speed
0B38:                   _atSfxPlay_UserSpeed:
                        	; Z80> ld (ix + _atDEF_SfxOffset_speed + 1), a
0B38: CD100D   [17]     	call z_ix_sta
0B3B: 2C                	db _atDEF_SfxOffset_speed + 1
                        	; Z80> ld (ix + _atDEF_SfxOffset_speedCtr + 1), a
0B3C: CD100D   [34]     	call z_ix_sta
0B3F: 23                	db _atDEF_SfxOffset_speedCtr + 1
0B40: 23       [40]     	inc hl	;Skip Retrig
0B41: 23       [46]     	inc hl
                        	; Z80> ld (ix + _atDEF_SfxOffset_instrument + 1), l
0B42: 327B0E   [59]     	ld (z_a),a
0B45: 7D       [63]     	ld a,l
0B46: CD100D   [80]     	call z_ix_sta
0B49: 07                	db _atDEF_SfxOffset_instrument + 1
0B4A: 3A7B0E   [93]     	ld a,(z_a)
                        	; Z80> ld (ix + _atDEF_SfxOffset_instrument + 2), h
0B4D: 327B0E   [106]    	ld (z_a),a
0B50: 7C       [110]    	ld a,h
0B51: CD100D   [127]    	call z_ix_sta
0B54: 08                	db _atDEF_SfxOffset_instrument + 2
0B55: 3A7B0E   [140]    	ld a,(z_a)
0B58: C9       [150]    	ret
                        
                        	;Stops a sound effect on the selected channel
                        	;A = No Channel (0,1,2)
0B59:                   atSfxStop:
0B59: 212705   [10]     	ld hl, _atVAR_SfxTrack1_instrument + 1
0B5C: 3D       [14]     	dec a
0B5D: FA690B   [24|24]  	jp m, _atSfxStop_ChannelFound
0B60: 218A04   [34]     	ld hl, _atVAR_SfxTrack2_instrument + 1
0B63: CA6A0B   [44|44]  	jp z, _atSfxStop_ChannelFound + 1
0B66: 21F503   [54]     	ld hl, _atVAR_SfxTrack3_instrument + 1
0B69:                   _atSfxStop_ChannelFound:
0B69: AF       [ 4]     	xor a
0B6A: 77       [11]     	ld (hl), a
0B6B: 23       [17]     	inc hl
0B6C: 77       [24]     	ld (hl), a
0B6D: C9       [34]     	ret
                        
                        	endif
                        
                        	;*** Optionnal Fade API ********************************************************
                        
                        	if atCNF_FADE
                        atFade:
                        	ld (_azVAR_FadeChA), a
                        	ld (_azVAR_FadeChB), a
                        	ld (_azVAR_FadeChC), a
                        	ret
                        	endif
                        
                        
                        #include "../../src/vec/z80rt.asm"
                        ; z80rt.asm — рантайм-хелперы для кода, оттранслированного z80to8080.py.
                        ; Только i8080 (проверяется zasm --8080). Контракт: каждый хелпер бережёт
                        ; HL, BC, DE, A и флаги, кроме явно объявленного результата.
                        ;
                        ; Ячейки (в vec_vars.asm): z_ix, z_iy (2 байта), z_a (1), z_tmp (1), z_ret (2),
                        ; z_af2, z_bc2, z_de2, z_hl2 (2).
                        
                        ; ---------------------------------------------------------------------------
                        ; ld a,(ix+d): вход A=d. Выход A=(ix+d). Флаги сохранены.
0B6E:                   z_ix_rda:
0B6E: E5       [11]     	push hl
0B6F: F5       [22]     	push af
0B70: 2A770E   [38]     	ld hl,(z_ix)
0B73: 85       [42]     	add a,l
0B74: 6F       [46]     	ld l,a
0B75: 7C       [50]     	ld a,h
0B76: CE00     [57]     	adc a,0
0B78: 67       [61]     	ld h,a
0B79: F1       [71]     	pop af
0B7A: 7E       [78]     	ld a,(hl)
0B7B: E1       [88]     	pop hl
0B7C: C9       [98]     	ret
                        ; то же, флаги можно портить (после инструкции они мертвы)
0B7D:                   z_ix_rda_nf:
0B7D: E5       [11]     	push hl
0B7E: 2A770E   [27]     	ld hl,(z_ix)
0B81: 85       [31]     	add a,l
0B82: 6F       [35]     	ld l,a
0B83: 7C       [39]     	ld a,h
0B84: CE00     [46]     	adc a,0
0B86: 67       [50]     	ld h,a
0B87: 7E       [57]     	ld a,(hl)
0B88: E1       [67]     	pop hl
0B89: C9       [77]     	ret
0B8A:                   z_iy_rda:
0B8A: E5       [11]     	push hl
0B8B: F5       [22]     	push af
0B8C: 2A790E   [38]     	ld hl,(z_iy)
0B8F: 85       [42]     	add a,l
0B90: 6F       [46]     	ld l,a
0B91: 7C       [50]     	ld a,h
0B92: CE00     [57]     	adc a,0
0B94: 67       [61]     	ld h,a
0B95: F1       [71]     	pop af
0B96: 7E       [78]     	ld a,(hl)
0B97: E1       [88]     	pop hl
0B98: C9       [98]     	ret
0B99:                   z_iy_rda_nf:
0B99: E5       [11]     	push hl
0B9A: 2A790E   [27]     	ld hl,(z_iy)
0B9D: 85       [31]     	add a,l
0B9E: 6F       [35]     	ld l,a
0B9F: 7C       [39]     	ld a,h
0BA0: CE00     [46]     	adc a,0
0BA2: 67       [50]     	ld h,a
0BA3: 7E       [57]     	ld a,(hl)
0BA4: E1       [67]     	pop hl
0BA5: C9       [77]     	ret
                        
                        ; ---------------------------------------------------------------------------
                        ; HL := ix+d, d — байт после call. Бережёт A, флаги, BC, DE. HL — результат.
                        ; (вызывающий сам сохраняет HL, если нужно)
0BA6:                   z_ix_hl:
0BA6: E3       [19]     	ex (sp),hl		; HL=адрес возврата, (SP)=старый HL (не нужен)
0BA7: F5       [30]     	push af
0BA8: 7E       [37]     	ld a,(hl)		; d
0BA9: 23       [43]     	inc hl
0BAA: 227D0E   [59]     	ld (z_ret),hl
0BAD: 2A770E   [75]     	ld hl,(z_ix)
0BB0: 85       [79]     	add a,l
0BB1: 6F       [83]     	ld l,a
0BB2: 7C       [87]     	ld a,h
0BB3: CE00     [94]     	adc a,0
0BB5: 67       [98]     	ld h,a
0BB6: F1       [108]    	pop af
0BB7: E3       [127]    	ex (sp),hl		; HL=результат... нет: (SP)=старый HL -> вернём через z_ret
                        	; сейчас HL=старый HL, (SP)=результат. Нам нужно вернуть результат в HL,
                        	; а на стек положить адрес возврата.
0BB8: E1       [137]    	pop hl			; HL=результат, стек чист
0BB9: E5       [148]    	push hl
0BBA: 2A7D0E   [164]    	ld hl,(z_ret)
0BBD: E3       [183]    	ex (sp),hl		; (SP)=адрес возврата, HL=результат
0BBE: C9       [193]    	ret
0BBF:                   z_iy_hl:
0BBF: E3       [19]     	ex (sp),hl
0BC0: F5       [30]     	push af
0BC1: 7E       [37]     	ld a,(hl)
0BC2: 23       [43]     	inc hl
0BC3: 227D0E   [59]     	ld (z_ret),hl
0BC6: 2A790E   [75]     	ld hl,(z_iy)
0BC9: 85       [79]     	add a,l
0BCA: 6F       [83]     	ld l,a
0BCB: 7C       [87]     	ld a,h
0BCC: CE00     [94]     	adc a,0
0BCE: 67       [98]     	ld h,a
0BCF: F1       [108]    	pop af
0BD0: E3       [127]    	ex (sp),hl
0BD1: E1       [137]    	pop hl
0BD2: E5       [148]    	push hl
0BD3: 2A7D0E   [164]    	ld hl,(z_ret)
0BD6: E3       [183]    	ex (sp),hl
0BD7: C9       [193]    	ret
                        
                        ; ---------------------------------------------------------------------------
                        ; ld r,(ix+d) для r=b,c,d,e,h,l и ld (ix+d),r; d — байт после call.
                        ; Реализованы через общий каркас: HL=ix+d вычисляется, затем действие.
                        ; Макрос-подобная раскладка руками (i8080, без макросов zasm ради простоты).
                        
                        ; --- чтение в регистр (не A, не H/L): бережёт A, флаги, HL
0BD8:                   z_ix_rd_b:
0BD8: E3       [19]     	ex (sp),hl
0BD9: F5       [30]     	push af
0BDA: 7E       [37]     	ld a,(hl)
0BDB: 23       [43]     	inc hl
0BDC: 227D0E   [59]     	ld (z_ret),hl
0BDF: 2A770E   [75]     	ld hl,(z_ix)
0BE2: 85       [79]     	add a,l
0BE3: 6F       [83]     	ld l,a
0BE4: 7C       [87]     	ld a,h
0BE5: CE00     [94]     	adc a,0
0BE7: 67       [98]     	ld h,a
0BE8: 46       [105]    	ld b,(hl)
0BE9: 2A7D0E   [121]    	ld hl,(z_ret)
0BEC: F1       [131]    	pop af
0BED: E3       [150]    	ex (sp),hl
0BEE: C9       [160]    	ret
0BEF:                   z_ix_rd_c:
0BEF: E3       [19]     	ex (sp),hl
0BF0: F5       [30]     	push af
0BF1: 7E       [37]     	ld a,(hl)
0BF2: 23       [43]     	inc hl
0BF3: 227D0E   [59]     	ld (z_ret),hl
0BF6: 2A770E   [75]     	ld hl,(z_ix)
0BF9: 85       [79]     	add a,l
0BFA: 6F       [83]     	ld l,a
