0147: 32A409   [66]     	ld (ps_pitch+1),a
014A:                   ch3_pgo:
014A: 2AE909   [16]     	ld hl,(t3_note)			; L = нота, H = инвертированная громкость
014D: EB       [20]     	ex de,hl			; D = громкость, E = нота
014E: 2AEB09   [36]     	ld hl,(t3_iptr)
