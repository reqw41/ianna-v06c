                        	;*** Player controls ***********************************************************
                        
                        	; Initialize player
                        	;  Input:
                        	;	DE = song data address
08E1:                   atInit:
08E1: 210900   [10]     	ld hl, 9	;Skip Header, SampleChannel, YM Clock (DB*3), and Replay Frequency.
08E4: 19       [21]     	add hl, de
                        
08E5: 118B03   [31]     	ld de, _atVAR_SongSpeed + 1
                        	; Z80> ldi 	;Copy Speed.
08E8: CDB30C   [48]     	call z_ldi
08EB: 4E       [55]     	ld c, (hl)	;Get Instruments chunk size.
08EC: 23       [61]     	inc hl
08ED: 46       [68]     	ld b, (hl)
08EE: 23       [74]     	inc hl
08EF: 225B02   [90]     	ld (_atVAR_Track1InstrumentLUT + 1), hl
08F2: 22E102   [106]    	ld (_atVAR_Track2InstrumentLUT + 1), hl
08F5: 226703   [122]    	ld (_atVAR_Track3InstrumentLUT + 1), hl
                        
08F8: 09       [133]    	add hl, bc	;Skip Instruments to go to the Linker address.
                        	;Get the pre-Linker information of the first pattern.
08F9: 11C901   [143]    	ld de, _atVAR_PatternHeight + 1
                        	; Z80> ldi 
08FC: CDB30C   [160]    	call z_ldi
08FF: 113602   [170]    	ld de, _atVAR_TranspCh1 + 1
                        	; Z80> ldi 
0902: CDB30C   [187]    	call z_ldi
0905: 11BC02   [197]    	ld de, _atVAR_TranspCh2 + 1
                        	; Z80> ldi 
0908: CDB30C   [214]    	call z_ldi
090B: 114203   [224]    	ld de, _atVAR_TranspCh3 + 1
                        	; Z80> ldi 
090E: CDB30C   [241]    	call z_ldi
0911: 11B501   [251]    	ld de, _atVAR_SpecialTrackAddr + 1
                        	; Z80> ldi 
0914: CDB30C   [268]    	call z_ldi
                        	; Z80> ldi 
0917: CDB30C   [285]    	call z_ldi
091A: 225001   [301]    	ld (_atVAR_Linker + 1), hl	;Get the Linker address.
                        
091D: 3E01     [308]    	ld a, 1
091F: 324401   [321]    	ld (_atVAR_SongSpeedCtr + 1), a
0922: 324A01   [334]    	ld (_atVAR_patternHeightCtr + 1), a
                        
0925: 3EFF     [341]    	ld a, $ff
0927: 326205   [354]    	ld (_atVAR_Reg13), a
                        
                        	;Set the Instruments pointers to Instrument 0 data (Header has to be skipped).
092A: 2A5B02   [370]    	ld hl, (_atVAR_Track1InstrumentLUT + 1)
092D: 5E       [377]    	ld e, (hl)
092E: 23       [383]    	inc hl
092F: 56       [390]    	ld d, (hl)
0930: EB       [394]    	ex de, hl
0931: 23       [400]    	inc hl	;Skip Instrument 0 Header.
0932: 23       [406]    	inc hl
0933: 228A04   [422]    	ld (_atVAR_Track1InstrumentPtr + 1), hl
0936: 221904   [438]    	ld (_atVAR_Track2InstrumentPtr + 1), hl
0939: 22AF03   [454]    	ld (_atVAR_Track3InstrumentPtr + 1), hl
093C: C9       [464]    	ret
                        
                        
                        
                        	;Stop the music, cut the channels.
093D:                   atStop:
093D: 215B05   [10]     	ld hl, _atVAR_Reg8	; Clear R8,R9 and R10 to zero
0940: 010003   [20]     	ld bc, $0300
0943: 71       [27]     	ld (hl), c
0944: 23       [33]     	inc hl
                        	; Z80> djnz $-2
0945: 05       [37]     	dec b
0946: C24309   [47|47]  	jp nz,$-1-2
                        ; !!FLAGS djnz: dec b меняет Z/S/P
0949: 3E3F     [54]     	ld a, %00111111	; Disable Tone and Noise on all channels
094B: C3D604   [64]     	jp _atAY3Update
                        
                        
                        	;*** Optionnal Sound effect API ************************************************
                        
                        	if atCNF_SFX
                        
                        	;Initialize the Sound Effects.
                        	; DE = SFX Music.
094E:                   atSfxInit:
                        	;Find the Instrument Table.
094E: 210C00   [10]     	ld hl, 12
0951: 19       [21]     	add hl, de
0952: 229909   [37]     	ld (_atSfxPlay_InstrumentTable + 1), hl
                        
                        	;Clear the three channels of any sound effect.
0955:                   atSfxStopAll:
0955: 210000   [10]     	ld hl, 0
0958: 22A504   [26]     	ld (_atVAR_SfxTrack1_instrument + 1), hl
095B: 223404   [42]     	ld (_atVAR_SfxTrack2_instrument + 1), hl
095E: 22CA03   [58]     	ld (_atVAR_SfxTrack3_instrument + 1), hl
0961: C9       [68]     	ret
                        
                        
0000:                   _atDEF_SfxOffset_pitch:	equ 0
0011:                   _atDEF_SfxOffset_volume:	equ _atVAR_SfxTrack1_volume		- _atVAR_SfxTrack1_pitch
0010:                   _atDEF_SfxOffset_note:	equ _atVAR_SfxTrack1_note		- _atVAR_SfxTrack1_pitch
0007:                   _atDEF_SfxOffset_instrument:	equ _atVAR_SfxTrack1_instrument		- _atVAR_SfxTrack1_pitch
002C:                   _atDEF_SfxOffset_speed:	equ _atVAR_SfxTrack1_instrumentSpeed	- _atVAR_SfxTrack1_pitch
0023:                   _atDEF_SfxOffset_speedCtr:	equ _atVAR_SfxTrack1_instrumentSpeedCtr	- _atVAR_SfxTrack1_pitch
                        
                        
                        	;Plays a Sound Effects along with the music.
                        	; Input
                        	;	A = No Channel (0,1,2)
                        	;	L = SFX Number (>0)
                        	;	H = Volume (0...F)
                        	;	E = Note (0...143)
                        	;	D = Speed (0 = As original, 1...255 = new Speed (1 is fastest))
                        	;	BC = Inverted Pitch (-#FFFF -> FFFF). 0 is no pitch. The higher the pitch, the lower the sound.
0962:                   atSfxPlay:
                        	; Z80> ld ix, _atVAR_SfxTrack1_pitch
0962: E5       [11]     	push hl
0963: 219D04   [21]     	ld hl,_atVAR_SfxTrack1_pitch
0966: 22E50C   [37]     	ld (z_ix),hl
0969: E1       [47]     	pop hl
096A: 3D       [51]     	dec a
096B: FA8109   [61|61]  	jp m, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack2_pitch
096E: E5       [72]     	push hl
096F: 212C04   [82]     	ld hl,_atVAR_SfxTrack2_pitch
0972: 22E50C   [98]     	ld (z_ix),hl
0975: E1       [108]    	pop hl
0976: CA8109   [118|118]	jp z, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack3_pitch
0979: E5       [129]    	push hl
097A: 21C203   [139]    	ld hl,_atVAR_SfxTrack3_pitch
097D: 22E50C   [155]    	ld (z_ix),hl
0980: E1       [165]    	pop hl
                        
0981:                   _atSfxPlay_Selected:
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 1), c	;Set Pitch
0981: CDC30B   [17]     	call z_ix_st_c
0984: 01                	db _atDEF_SfxOffset_pitch + 1
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 2), b
0985: CDAC0B   [34]     	call z_ix_st_b
0988: 02                	db _atDEF_SfxOffset_pitch + 2
0989: 7B       [38]     	ld a, e	;Set Note
                        	; Z80> ld (ix + _atDEF_SfxOffset_note), a
098A: CD7E0B   [55]     	call z_ix_sta
098D: 10                	db _atDEF_SfxOffset_note
098E: 3E0F     [62]     	ld a, 15	;Set Volume
0990: 94       [66]     	sub h
                        	; Z80> ld (ix + _atDEF_SfxOffset_volume), a
0991: CD7E0B   [83]     	call z_ix_sta
0994: 11                	db _atDEF_SfxOffset_volume
0995: 2600     [90]     	ld h, 0	;Set Instrument Address
0997: 29       [101]    	add hl, hl
0998:                   _atSfxPlay_InstrumentTable:
0998: 010000   [10]     	ld bc, 0
099B: 09       [21]     	add hl, bc
099C: 7E       [28]     	ld a, (hl)
099D: 23       [34]     	inc hl
099E: 66       [41]     	ld h, (hl)
099F: 6F       [45]     	ld l, a
09A0: 7A       [49]     	ld a, d	;Read Speed or use the user's one ?
09A1: B7       [53]     	or a
09A2: C2A609   [63|63]  	jp nz, _atSfxPlay_UserSpeed
09A5: 7E       [70]     	ld a, (hl)	;Get Speed
09A6:                   _atSfxPlay_UserSpeed:
                        	; Z80> ld (ix + _atDEF_SfxOffset_speed + 1), a
09A6: CD7E0B   [17]     	call z_ix_sta
09A9: 2D                	db _atDEF_SfxOffset_speed + 1
                        	; Z80> ld (ix + _atDEF_SfxOffset_speedCtr + 1), a
09AA: CD7E0B   [34]     	call z_ix_sta
09AD: 24                	db _atDEF_SfxOffset_speedCtr + 1
09AE: 23       [40]     	inc hl	;Skip Retrig
09AF: 23       [46]     	inc hl
                        	; Z80> ld (ix + _atDEF_SfxOffset_instrument + 1), l
09B0: 32E90C   [59]     	ld (z_a),a
09B3: 7D       [63]     	ld a,l
09B4: CD7E0B   [80]     	call z_ix_sta
09B7: 08                	db _atDEF_SfxOffset_instrument + 1
09B8: 3AE90C   [93]     	ld a,(z_a)
                        	; Z80> ld (ix + _atDEF_SfxOffset_instrument + 2), h
09BB: 32E90C   [106]    	ld (z_a),a
09BE: 7C       [110]    	ld a,h
09BF: CD7E0B   [127]    	call z_ix_sta
09C2: 09                	db _atDEF_SfxOffset_instrument + 2
09C3: 3AE90C   [140]    	ld a,(z_a)
09C6: C9       [150]    	ret
                        
                        	;Stops a sound effect on the selected channel
                        	;A = No Channel (0,1,2)
09C7:                   atSfxStop:
09C7: 21A504   [10]     	ld hl, _atVAR_SfxTrack1_instrument + 1
09CA: 3D       [14]     	dec a
09CB: FAD709   [24|24]  	jp m, _atSfxStop_ChannelFound
09CE: 213404   [34]     	ld hl, _atVAR_SfxTrack2_instrument + 1
09D1: CAD809   [44|44]  	jp z, _atSfxStop_ChannelFound + 1
09D4: 21CA03   [54]     	ld hl, _atVAR_SfxTrack3_instrument + 1
09D7:                   _atSfxStop_ChannelFound:
09D7: AF       [ 4]     	xor a
09D8: 77       [11]     	ld (hl), a
09D9: 23       [17]     	inc hl
09DA: 77       [24]     	ld (hl), a
09DB: C9       [34]     	ret
                        
                        	endif
                        
                        	;*** Optionnal Fade API ********************************************************
                        
                        	if atCNF_FADE
                        atFade:
                        	ld (_azVAR_FadeChA), a
                        	ld (_azVAR_FadeChB), a
                        	ld (_azVAR_FadeChC), a
                        	ret
                        	endif
                        
                        
                        #include "../../src/vec/z80rt.asm"
                        ; z80rt.asm — рантайм-хелперы для кода, оттранслированного z80to8080.py.
                        ; Только i8080 (проверяется zasm --8080). Контракт: каждый хелпер бережёт
                        ; HL, BC, DE, A и флаги, кроме явно объявленного результата.
                        ;
                        ; Ячейки (в vec_vars.asm): z_ix, z_iy (2 байта), z_a (1), z_tmp (1), z_ret (2),
                        ; z_af2, z_bc2, z_de2, z_hl2 (2).
                        
                        ; ---------------------------------------------------------------------------
                        ; ld a,(ix+d): вход A=d. Выход A=(ix+d). Флаги сохранены.
09DC:                   z_ix_rda:
09DC: E5       [11]     	push hl
09DD: F5       [22]     	push af
09DE: 2AE50C   [38]     	ld hl,(z_ix)
09E1: 85       [42]     	add a,l
09E2: 6F       [46]     	ld l,a
09E3: 7C       [50]     	ld a,h
09E4: CE00     [57]     	adc a,0
09E6: 67       [61]     	ld h,a
09E7: F1       [71]     	pop af
09E8: 7E       [78]     	ld a,(hl)
09E9: E1       [88]     	pop hl
09EA: C9       [98]     	ret
                        ; то же, флаги можно портить (после инструкции они мертвы)
09EB:                   z_ix_rda_nf:
09EB: E5       [11]     	push hl
09EC: 2AE50C   [27]     	ld hl,(z_ix)
09EF: 85       [31]     	add a,l
09F0: 6F       [35]     	ld l,a
09F1: 7C       [39]     	ld a,h
09F2: CE00     [46]     	adc a,0
09F4: 67       [50]     	ld h,a
09F5: 7E       [57]     	ld a,(hl)
09F6: E1       [67]     	pop hl
09F7: C9       [77]     	ret
09F8:                   z_iy_rda:
