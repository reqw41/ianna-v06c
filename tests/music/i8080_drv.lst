080A: 3A7B0E   [37]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
080D: CA2108   [47|47]  	jp z, PLY_PS_Independent	;of the flags, making it uncompatible with the common code.
                        
                        	;The sound has ended.
                        	;If Sound Effects activated, we mark the "end of sound" by returning a 0 as an address.
                        	if atCNF_SFX
0810:                   PLY_PS_EndSound_SFX:
0810: 3E00     [ 7]     	ld a, 0	;Is the sound played is a SFX (1) or a normal sound (0) ?
0812: B7       [11]     	or a
0813: C21D08   [21|21]  	jp nz, PLY_PS_EndSFX
                        	endif
                        
                        	;The sound has ended. Read the new pointer and restart instrument.
0816: 7E       [28]     	ld a, (hl)
