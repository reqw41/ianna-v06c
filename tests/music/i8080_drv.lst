                        	if atCNF_ZXPT
                        	;					dw 4095,4095,4095,4095,4095,4095,4095,4095,4095,4030,3804,3591
0953: DC0E070E          	dw 3804, 3591
0957: 3D0D7F0C          	dw 3389, 3199, 3019, 2850, 2690, 2539, 2397, 2262, 2135, 2015, 1902, 1795
095B: CB0B220B          
095F: 820AEB09          
0963: 5D09D608          
