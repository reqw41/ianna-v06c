                        	;Noise ?
0651: 79       [58]     	ld a, c
0652: E61F     [65]     	and %11111
0654: CA6106   [75|75]  	jp z, PLY_PS_S_SBN_NoNoise
0657: 32DD05   [88]     	ld (_atVAR_Reg6), a
                        	; Z80> ld ixl, %0000	;Open Noise Channel.
065A: F5       [99]     	push af
065B: 3E00     [106]    	ld a,%0000
065D: 32770E   [119]    	ld (z_ix),a
0660: F1       [129]    	pop af
0661:                   PLY_PS_S_SBN_NoNoise:
                        
                        	;Here we have either Volume and/or Sound. So first we need to read the Volume.
0661: 78       [ 4]     	ld a, b
0662: E60F     [11]     	and %1111
0664: 92       [15]     	sub d	;Code Volume.
0665: D26906   [25|25]  	jp nc, $+1+3
0668: AF       [29]     	xor a
                        	; Z80> ld (iy+7), a
0669: CD270D   [46]     	call z_iy_sta
066C: 07                	db 7
                        
                        	;Sound ?
                        	; Z80> bit 5, c
066D: 327B0E   [59]     	ld (z_a),a
