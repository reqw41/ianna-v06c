                        #include "../../src/vec/z80rt.asm"
                        ; z80rt.asm — рантайм-хелперы для кода, оттранслированного z80to8080.py.
                        ; Только i8080 (проверяется zasm --8080). Контракт: каждый хелпер бережёт
                        ; HL, BC, DE, A и флаги, кроме явно объявленного результата.
                        ;
                        ; Ячейки (в vec_vars.asm): z_ix, z_iy (2 байта), z_a (1), z_tmp (1), z_ret (2),
                        ; z_af2, z_bc2, z_de2, z_hl2 (2).
                        
                        ; ---------------------------------------------------------------------------
                        ; ld a,(ix+d): вход A=d. Выход A=(ix+d). Флаги сохранены.
0AEF:                   z_ix_rda:
0AEF: E5       [11]     	push hl
0AF0: F5       [22]     	push af
0AF1: 2A940D   [38]     	ld hl,(z_ix)
0AF4: 85       [42]     	add a,l
0AF5: 6F       [46]     	ld l,a
0AF6: D2FA0A   [56|56]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0AF9: 24       [60]     	inc h
0AFA: F1       [70]     	pop af
0AFB: 7E       [77]     	ld a,(hl)
0AFC: E1       [87]     	pop hl
0AFD: C9       [97]     	ret
                        ; то же, флаги можно портить (после инструкции они мертвы)
0AFE:                   z_ix_rda_nf:
0AFE: E5       [11]     	push hl
0AFF: 2A940D   [27]     	ld hl,(z_ix)
0B02: 85       [31]     	add a,l
0B03: 6F       [35]     	ld l,a
0B04: D2080B   [45|45]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0B07: 24       [49]     	inc h
0B08: 7E       [56]     	ld a,(hl)
0B09: E1       [66]     	pop hl
0B0A: C9       [76]     	ret
0B0B:                   z_iy_rda:
0B0B: E5       [11]     	push hl
0B0C: F5       [22]     	push af
0B0D: 2A960D   [38]     	ld hl,(z_iy)
0B10: 85       [42]     	add a,l
0B11: 6F       [46]     	ld l,a
0B12: D2160B   [56|56]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0B15: 24       [60]     	inc h
0B16: F1       [70]     	pop af
0B17: 7E       [77]     	ld a,(hl)
