09FE: 6F       [46]     	ld l,a
09FF: 7C       [50]     	ld a,h
0A00: CE00     [57]     	adc a,0
0A02: 67       [61]     	ld h,a
0A03: F1       [71]     	pop af
0A04: 7E       [78]     	ld a,(hl)
0A05: E1       [88]     	pop hl
0A06: C9       [98]     	ret
