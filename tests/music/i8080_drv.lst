0AF3: E5       [147]    	push hl
0AF4: 2A530D   [163]    	ld hl,(z_ret)
0AF7: E3       [182]    	ex (sp),hl		; (SP)=адрес возврата, HL=результат
0AF8: C9       [192]    	ret
