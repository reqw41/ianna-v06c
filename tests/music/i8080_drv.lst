0AEC: D2F00A   [93|93]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0AEF: 24       [97]     	inc h
0AF0: F1       [107]    	pop af
0AF1: E3       [126]    	ex (sp),hl		; HL=результат... нет: (SP)=старый HL -> вернём через z_ret
                        	; сейчас HL=старый HL, (SP)=результат. Нам нужно вернуть результат в HL,
