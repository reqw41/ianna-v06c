02C9: 7A       [63]     	ld a,d
02CA: 17       [67]     	rla
02CB: 57       [71]     	ld d,a
02CC: 3A7B0E   [84]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
02CF: DADE02   [94|94]  	jp c, _atTrack2LoadInstrument
                        	; Same Instrument. We recover its address to restart it.
02D2:                   _atVAR_Track2InstAddr:
02D2: 210000   [10]     	ld hl, 0
