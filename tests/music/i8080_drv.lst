03B0: EB       [54]     	ex de,hl			; DE = частота, HL = указатель инструмента
03B1: B7       [58]     	or a				; CY = 0: частота посчитана
03B2: C9       [68]     	ret
                        
                        ; второй байт: шум и/или запрет тона, возможна ручная частота
03B3:                   ps_second:
