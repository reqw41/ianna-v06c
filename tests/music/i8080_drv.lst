0671: E620     [70]     	and $20
0673: 3A7B0E   [83]     	ld a,(z_a)
                        ; !!FLAGS bit: CY=0 (Z80 сохраняет CY)
0676: C28006   [93|93]  	jp nz, PLY_PS_S_SBN_Sound
                        	;No Sound. Stop here.
                        	; Z80> inc ixl	;Set Sound bit to stop the Sound.
0679: E5       [104]    	push hl
067A: 21770E   [114]    	ld hl,z_ix
067D: 34       [125]    	inc (hl)
067E: E1       [135]    	pop hl
067F: C9       [145]    	ret
                        
0680:                   PLY_PS_S_SBN_Sound:
                        	;Manual Frequency ?
                        	; Z80> rr b	;Needed for the subroutine to get the good flags.
0680: 327B0E   [13]     	ld (z_a),a
0683: 78       [17]     	ld a,b
0684: 1F       [21]     	rra
0685: 47       [25]     	ld b,a
0686: 3A7B0E   [38]     	ld a,(z_a)
                        	; Z80> bit 6, c
