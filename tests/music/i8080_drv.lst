0818: 66       [41]     	ld h, (hl)
0819: 6F       [45]     	ld l, a
081A: C3E605   [55]     	jp _atPlaySound
                        
                        	if atCNF_SFX
081D:                   PLY_PS_EndSFX:
081D: 210000   [10]     	ld hl, 0
0820: C9       [20]     	ret
                        	endif
                        
                        
                        
                        
                        	;***********
                        	;Independent
