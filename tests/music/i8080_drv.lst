0889: 1F       [96]     	rra
088A: 47       [100]    	ld b,a
088B: 3A7B0E   [113]    	ld a,(z_a)
                        	; Z80> bit 4-2, b	;Manual Hardware Frequency ? -2 Because the byte has been shifted previously.
088E: 327B0E   [126]    	ld (z_a),a
0891: 78       [130]    	ld a,b
0892: E604     [137]    	and 1<<(4-2)
0894: 3A7B0E   [150]    	ld a,(z_a)
0897: CDB808   [167]    	call _atSound_getFrequency
089A: 22E305   [183]    	ld (_atVAR_Reg11), hl	;Code Hardware Frequency.
                        	; Z80> exx 
089D: CD4D0E   [200]    	call z_exx
                        
                        	;Noise ? We can't use the previous common code, because the setting of the Noise is different, since Independent can have no Sound.
                        	; Z80> bit 7-2, b
08A0: 327B0E   [213]    	ld (z_a),a
08A3: 78       [217]    	ld a,b
08A4: E620     [224]    	and 1<<(7-2)
08A6: 3A7B0E   [237]    	ld a,(z_a)
