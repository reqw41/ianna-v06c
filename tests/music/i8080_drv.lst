                        	;(nbGrim - these sound routines need some tweaks imo)
                        
                        	;Plays a sound stream.
                        	;HL=Pointer on Instrument Data
                        	;IY=Pointer on Register code (volume, frequency).
                        	;E=Note
                        	;D=Inverted Volume
                        	;DE'=TrackPitch
                        
                        	;RET=
                        	;HL=New Instrument pointer.
                        	;IXL=Reg7 mask (x00x)
                        
                        	;Also used inside =
                        	;B,C=read byte/second byte.
                        	;IXH=Save original Note (only used for Independant mode).
                        
                        
05E6:                   _atPlaySound:
05E6: 46       [ 7]     	ld b, (hl)
05E7: 23       [13]     	inc hl
                        	; Z80> rr b
05E8: 327B0E   [26]     	ld (z_a),a
05EB: 78       [30]     	ld a,b
05EC: 1F       [34]     	rra
05ED: 47       [38]     	ld b,a
05EE: 3A7B0E   [51]     	ld a,(z_a)
                        ; !!FLAGS rr: нет Z/S/P (только CY)
05F1: DAAF06   [61|61]  	jp c, PLY_PS_Hard
                        
                        	;**************
                        	;Software Sound
                        	;**************
                        	;Second Byte needed ?
                        	; Z80> rr b
05F4: 327B0E   [74]     	ld (z_a),a
05F7: 78       [78]     	ld a,b
05F8: 1F       [82]     	rra
05F9: 47       [86]     	ld b,a
05FA: 3A7B0E   [99]     	ld a,(z_a)
                        ; !!FLAGS rr: нет Z/S/P (только CY)
05FD: DA4806   [109|109]	jp c, PLY_PS_S_SecondByteNeeded
                        
                        	;No second byte needed. We need to check if Volume is null or not.
0600: 78       [113]    	ld a, b
0601: E60F     [120]    	and %1111
0603: C21206   [130|130]	jp nz, PLY_PS_S_SoundOn
                        
                        	;Null Volume. It means no Sound. We stop the Sound, the Noise, and it's over.
                        	; Z80> ld (iy+7), a	;We have to make the volume to 0, because if a bass Hard was activated before, we have to stop it.
0606: CD270D   [147]    	call z_iy_sta
0609: 07                	db 7
                        	; Z80> ld ixl, %1001
060A: F5       [158]    	push af
060B: 3E09     [165]    	ld a,%1001
060D: 32770E   [178]    	ld (z_ix),a
0610: F1       [188]    	pop af
0611: C9       [198]    	ret
                        
0612:                   PLY_PS_S_SoundOn:
                        	;Volume is here, no Second Byte needed. It means we have a simple Software sound (Sound = On, Noise = Off)
                        	;We have to test Arpeggio and Pitch, however.
                        	; Z80> ld ixl, %1000
0612: F5       [11]     	push af
0613: 3E08     [18]     	ld a,%1000
0615: 32770E   [31]     	ld (z_ix),a
0618: F1       [41]     	pop af
                        
0619: 92       [45]     	sub d	;Code Volume.
061A: D21E06   [55|55]  	jp nc, $+1+3
061D: AF       [59]     	xor a
                        	; Z80> ld (iy+7), a
061E: CD270D   [76]     	call z_iy_sta
0621: 07                	db 7
                        
                        	; Z80> rr b	;Needed for the subroutine to get the good flags.
0622: 327B0E   [89]     	ld (z_a),a
0625: 78       [93]     	ld a,b
0626: 1F       [97]     	rra
0627: 47       [101]    	ld b,a
0628: 3A7B0E   [114]    	ld a,(z_a)
062B: CDBB08   [131]    	call _atSound_calcFrequency
                        	; Z80> ld (iy+0), l	;Code Frequency.
062E: 327B0E   [144]    	ld (z_a),a
0631: 7D       [148]    	ld a,l
0632: CD270D   [165]    	call z_iy_sta
0635: 00                	db 0
0636: 3A7B0E   [178]    	ld a,(z_a)
                        	; Z80> ld (iy+1), h
0639: 327B0E   [191]    	ld (z_a),a
063C: 7C       [195]    	ld a,h
063D: CD270D   [212]    	call z_iy_sta
0640: 01                	db 1
0641: 3A7B0E   [225]    	ld a,(z_a)
                        	; Z80> exx 
0644: CD4D0E   [242]    	call z_exx
0647: C9       [252]    	ret
                        
                        
                        
0648:                   PLY_PS_S_SecondByteNeeded:
                        	; Z80> ld ixl, %1000	;By defaut, No Noise, Sound.
0648: F5       [11]     	push af
0649: 3E08     [18]     	ld a,%1000
064B: 32770E   [31]     	ld (z_ix),a
064E: F1       [41]     	pop af
                        
                        	;Second Byte needed.
064F: 4E       [48]     	ld c, (hl)
