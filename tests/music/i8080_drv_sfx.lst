04A9: 3E01     [171]    	ld a,1
04AB: 32AE09   [184]    	ld (ps_ihasf),a
04AE: 3AA909   [197]    	ld a,(ps_ixh)
04B1: 5F       [201]    	ld e,a
04B2: C3BA04   [211]    	jp ps_i_cont
