                        ;;; ============================== звук одного канала ==============================
                        ; Вход:  HL = указатель на данные инструмента, D = инвертированная громкость, E = нота,
                        ;        ps_pitch = питч трека (word), ps_sfx = 1, если это эффект.
                        ; Выход: HL = новый указатель (0 = звук эффекта кончился), DE = частота,
                        ;        CY = 1, если частота не считалась (её писать не нужно),
                        ;        ps_vol = байт громкости канала, ps_ixl = биты регистра 7 (бит 3 шум выкл, бит 0 тон выкл).
                        ; ps_ixl ЖИВЁТ МЕЖДУ ВЫЗОВАМИ: на кадре, когда эффект кончился, в R7 идёт значение музыкального
                        ; канала (проверено моделью: иначе расходятся 11 кадров из 6200 на каждой песне).
03E5:                   ps_sound:
03E5: 7E       [ 7]     	ld a,(hl)
03E6: 23       [13]     	inc hl
03E7: 1F       [17]     	rra				; бит 0: аппаратный звук?
03E8: DA4A04   [27|27]  	jp c,ps_hard
03EB: 1F       [31]     	rra				; бит 1: нужен второй байт?
03EC: DA1204   [41|41]  	jp c,ps_second
03EF: 47       [45]     	ld b,a				; B = байт>>2: биты 3-0 громкость, бит 5 питч, бит 4 арпеджио
03F0: E60F     [52]     	and $0F
03F2: C2FF03   [62|62]  	jp nz,ps_soundon
03F5: 32A709   [75]     	ld (ps_vol),a			; нулевая громкость: звука нет (A = 0)
03F8: 3E09     [82]     	ld a,%1001
03FA: 32A809   [95]     	ld (ps_ixl),a
03FD: 37       [99]     	scf
03FE: C9       [109]    	ret
03FF:                   ps_soundon:
03FF: 92       [ 4]     	sub d				; кодировать громкость
0400: D20404   [14|14]  	jp nc,ps_so1
0403: AF       [18]     	xor a
0404:                   ps_so1:
0404: 32A709   [13]     	ld (ps_vol),a
0407: 3E08     [20]     	ld a,%1000
0409: 32A809   [33]     	ld (ps_ixl),a
040C: CDF804   [50]     	call ps_calcfreq
040F: EB       [54]     	ex de,hl			; DE = частота, HL = указатель инструмента
0410: B7       [58]     	or a				; CY = 0: частота посчитана
0411: C9       [68]     	ret
                        
                        ; второй байт: шум и/или запрет тона, возможна ручная частота
0412:                   ps_second:
0412: 47       [ 4]     	ld b,a
0413: 3E08     [11]     	ld a,%1000
0415: 32A809   [24]     	ld (ps_ixl),a
0418: 4E       [31]     	ld c,(hl)
0419: 23       [37]     	inc hl
041A: 79       [41]     	ld a,c
041B: E61F     [48]     	and %11111			; шум?
041D: CA2704   [58|58]  	jp z,ps_sb_nonoise
0420: 32BF09   [71]     	ld (_atVAR_Reg6),a
0423: AF       [75]     	xor a
0424: 32A809   [88]     	ld (ps_ixl),a			; открыть шумовой канал
0427:                   ps_sb_nonoise:
0427: 78       [ 4]     	ld a,b
0428: E60F     [11]     	and $0F
042A: 92       [15]     	sub d
042B: D22F04   [25|25]  	jp nc,ps_sb1
042E: AF       [29]     	xor a
042F:                   ps_sb1:
042F: 32A709   [13]     	ld (ps_vol),a
0432: 79       [17]     	ld a,c
0433: E620     [24]     	and $20				; тон?
0435: C24104   [34|34]  	jp nz,ps_sb_sound
0438: 3AA809   [47]     	ld a,(ps_ixl)			; тона нет — поднять бит запрета
043B: 3C       [51]     	inc a
043C: 32A809   [64]     	ld (ps_ixl),a
043F: 37       [68]     	scf
0440: C9       [78]     	ret
0441:                   ps_sb_sound:
0441: 79       [ 4]     	ld a,c
0442: E640     [11]     	and $40				; ручная частота?
0444: CDF504   [28]     	call ps_getfreq
0447: EB       [32]     	ex de,hl
0448: B7       [36]     	or a
0449: C9       [46]     	ret
                        
                        ;;; --------------------------- аппаратный звук ---------------------------
044A:                   ps_hard:
044A: 1F       [ 4]     	rra				; бит 1: retrig? (в бит 7 уходит перенос — он нигде не читается)
044B: 47       [ 8]     	ld b,a
044C: D25F04   [18|18]  	jp nc,ps_h_noretrig
044F: 3ACE09   [31]     	ld a,(t1_ictr)			; retrig только на первом шаге строки инструмента (счётчики канала 1 —
0452: 4F       [35]     	ld c,a				; так в оригинале, для всех трёх каналов)
0453: 3ACD09   [48]     	ld a,(t1_ispeed)
0456: B9       [52]     	cp c
0457: C25F04   [62|62]  	jp nz,ps_h_noretrig
045A: 3EFE     [69]     	ld a,_atDEF_R13Retrig
045C: 32AF09   [82]     	ld (ps_r13lock),a
045F:                   ps_h_noretrig:
045F: 78       [ 4]     	ld a,b
0460: E602     [11]     	and 2
0462: CA7E04   [21|21]  	jp z,ps_h_dependent		; Software/Hardware Dependent — в данных игры не встречается
0465: 78       [25]     	ld a,b
0466: E601     [32]     	and 1
0468: CA8504   [42|42]  	jp z,ps_independent
046B: 3AAB09   [55]     	ld a,(ps_sfx)			; звук кончился
046E: B7       [59]     	or a
046F: C27904   [69|69]  	jp nz,ps_endsfx
0472: 7E       [76]     	ld a,(hl)			; обычный звук: перезапустить инструмент с нового адреса
0473: 23       [82]     	inc hl
0474: 66       [89]     	ld h,(hl)
0475: 6F       [93]     	ld l,a
0476: C3E503   [103]    	jp ps_sound
0479:                   ps_endsfx:
0479: 210000   [10]     	ld hl,0				; эффект кончился: ps_ixl и ps_vol не трогаем
047C: 37       [14]     	scf
047D: C9       [24]     	ret
                        ; Ветка есть только чтобы не уйти в мусор, если формат когда-нибудь принесёт эти команды:
                        ; гейт tools/arkos_model.py --check-unused обязан упасть раньше, чем это исполнится.
047E:                   ps_h_dependent:
047E: 3E09     [ 7]     	ld a,%1001
0480: 32A809   [20]     	ld (ps_ixl),a
0483: 37       [24]     	scf
0484: C9       [34]     	ret
                        
                        ;;; --------------------------- Independent ---------------------------
                        ; Аппаратная огибающая, независимая от тона. Встречается только в эффекте 19 (FX_LONGJUMP).
