08B8: 32C50A   [30]     	ld (ay_r0+9),a
08BB: 3E3F     [37]     	ld a,%00111111
08BD: C36603   [47]     	jp at_ay3update
                        
                        ; atSfxInit: DE = адрес набора эффектов.
