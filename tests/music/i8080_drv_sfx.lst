                        ; A = номер инструмента -> HL = адрес данных (заголовок пропущен), A = скорость,
                        ; at_rt_retrig = байт retrig.
0849:                   at_instr:
0849: 6F       [ 4]     	ld l,a
084A: 2600     [11]     	ld h,0
084C: 29       [22]     	add hl,hl
084D: EB       [26]     	ex de,hl
084E: 2A9B0A   [42]     	ld hl,(at_ilut)
0851: 19       [53]     	add hl,de
0852: 7E       [60]     	ld a,(hl)
0853: 23       [66]     	inc hl
0854: 66       [73]     	ld h,(hl)
0855: 6F       [77]     	ld l,a
0856: 7E       [84]     	ld a,(hl)			; скорость инструмента
0857: 23       [90]     	inc hl
0858: 57       [94]     	ld d,a
0859: 7E       [101]    	ld a,(hl)			; retrig
085A: 23       [107]    	inc hl
085B: 32A20A   [120]    	ld (at_rt_retrig),a
085E: 7A       [124]    	ld a,d
085F: C9       [134]    	ret
                        
                        ;;; ============================== управление ==============================
                        ; atInit: DE = адрес песни. Раскладка .mus: +9 скорость, +10 размер блока инструментов (word),
                        ; +12 таблица инструментов, за ней пре-линкер (высота паттерна, 3 транспозиции, адрес спец-трека).
0860:                   atInit:
0860: 210900   [10]     	ld hl,9
