034B: 2AA509   [97]     	ld hl,(ps_pblk)
034E: 73       [104]    	ld (hl),e
034F: 23       [110]    	inc hl
0350: 72       [117]    	ld (hl),d
0351: EB       [121]    	ex de,hl			; HL = питч
0352: 7C       [125]    	ld a,h				; >>1 арифметически
0353: 17       [129]    	rla
0354: 7C       [133]    	ld a,h
0355: 1F       [137]    	rra
0356: 67       [141]    	ld h,a
