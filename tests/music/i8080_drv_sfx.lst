0BF0: F5       [22]     	push af
0BF1: 2A940E   [38]     	ld hl,(z_ix)
0BF4: 85       [42]     	add a,l
0BF5: 6F       [46]     	ld l,a
0BF6: D2FA0B   [56|56]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0BF9: 24       [60]     	inc h
0BFA: F1       [70]     	pop af
0BFB: 7E       [77]     	ld a,(hl)
0BFC: E1       [87]     	pop hl
