                        ; медленная ветка питча: питч трека += приращение, ps_pitch = питч >> 2 (арифметически).
0323:                   ch3_pslow:
0323: 21F109   [10]     	ld hl,t3_pitch
0326: CD3E03   [27]     	call ps_pitchcalc
