0D04: 24       [92]     	inc h
0D05: EB       [96]     	ex de,hl		; DE=адрес назначения, HL=старый DE
0D06: E3       [115]    	ex (sp),hl		; HL=&n, (SP)=старый DE
0D07: 7E       [122]    	ld a,(hl)		; n
0D08: 23       [128]    	inc hl			; HL=адрес возврата (за двумя db)
0D09: 12       [135]    	ld (de),a
