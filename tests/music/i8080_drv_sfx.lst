0AB8: 2A4D0D   [27]     	ld hl,(z_ix)
0ABB: 85       [31]     	add a,l
0ABC: 6F       [35]     	ld l,a
0ABD: D2C10A   [45|45]  	jp nc,$+4	; перенос в старший байт редок (d мало): 12 тактов вместо 24
0AC0: 24       [49]     	inc h
0AC1: 7E       [56]     	ld a,(hl)
0AC2: E1       [66]     	pop hl
0AC3: C9       [76]     	ret
0AC4:                   z_iy_rda:
