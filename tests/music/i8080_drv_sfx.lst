035B: 17       [161]    	rla
035C: 7C       [165]    	ld a,h
035D: 1F       [169]    	rra
035E: 67       [173]    	ld h,a
035F: 7D       [177]    	ld a,l
0360: 1F       [181]    	rra
0361: 6F       [185]    	ld l,a
0362: 22A309   [201]    	ld (ps_pitch),hl
0365: C9       [211]    	ret
                        
                        ;;; ============================== вывод в AY ==============================
                        ; Вход: A = значение регистра 7 (сборка из битов каналов).
0366:                   at_ay3update:
