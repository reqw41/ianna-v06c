08A9: 23       [385]    	inc hl
08AA: 22CC0A   [401]    	ld (t1_iptr),hl
08AD: 22DD0A   [417]    	ld (t2_iptr),hl
08B0: 22EE0A   [433]    	ld (t3_iptr),hl
08B3: C9       [443]    	ret
                        
                        ; atStop: гасит громкости каналов 1 и 2 (оригинал чистит Reg8, digidrum, Reg9 — R10 не трогает)
                        ; и выключает тон и шум на всех каналах.
08B4:                   atStop:
08B4: AF       [ 4]     	xor a
