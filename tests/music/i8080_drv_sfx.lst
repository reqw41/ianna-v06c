                        	;*** Player controls ***********************************************************
                        
                        	; Initialize player
                        	;  Input:
                        	;	DE = song data address
0940:                   atInit:
0940: 210900   [10]     	ld hl, 9	;Skip Header, SampleChannel, YM Clock (DB*3), and Replay Frequency.
0943: 19       [21]     	add hl, de
                        
0944: 11EA03   [31]     	ld de, _atVAR_SongSpeed + 1
                        	; Z80> ldi 	;Copy Speed.
0947: CD120D   [48]     	call z_ldi
094A: 4E       [55]     	ld c, (hl)	;Get Instruments chunk size.
094B: 23       [61]     	inc hl
094C: 46       [68]     	ld b, (hl)
094D: 23       [74]     	inc hl
094E: 22BA02   [90]     	ld (_atVAR_Track1InstrumentLUT + 1), hl
0951: 224003   [106]    	ld (_atVAR_Track2InstrumentLUT + 1), hl
0954: 22C603   [122]    	ld (_atVAR_Track3InstrumentLUT + 1), hl
                        
0957: 09       [133]    	add hl, bc	;Skip Instruments to go to the Linker address.
                        	;Get the pre-Linker information of the first pattern.
0958: 112802   [143]    	ld de, _atVAR_PatternHeight + 1
                        	; Z80> ldi 
095B: CD120D   [160]    	call z_ldi
095E: 119502   [170]    	ld de, _atVAR_TranspCh1 + 1
                        	; Z80> ldi 
0961: CD120D   [187]    	call z_ldi
0964: 111B03   [197]    	ld de, _atVAR_TranspCh2 + 1
                        	; Z80> ldi 
0967: CD120D   [214]    	call z_ldi
096A: 11A103   [224]    	ld de, _atVAR_TranspCh3 + 1
                        	; Z80> ldi 
096D: CD120D   [241]    	call z_ldi
0970: 111402   [251]    	ld de, _atVAR_SpecialTrackAddr + 1
                        	; Z80> ldi 
0973: CD120D   [268]    	call z_ldi
                        	; Z80> ldi 
0976: CD120D   [285]    	call z_ldi
0979: 22AF01   [301]    	ld (_atVAR_Linker + 1), hl	;Get the Linker address.
                        
097C: 3E01     [308]    	ld a, 1
097E: 32A301   [321]    	ld (_atVAR_SongSpeedCtr + 1), a
0981: 32A901   [334]    	ld (_atVAR_patternHeightCtr + 1), a
                        
0984: 3EFF     [341]    	ld a, $ff
0986: 32C105   [354]    	ld (_atVAR_Reg13), a
                        
                        	;Set the Instruments pointers to Instrument 0 data (Header has to be skipped).
0989: 2ABA02   [370]    	ld hl, (_atVAR_Track1InstrumentLUT + 1)
098C: 5E       [377]    	ld e, (hl)
098D: 23       [383]    	inc hl
098E: 56       [390]    	ld d, (hl)
098F: EB       [394]    	ex de, hl
0990: 23       [400]    	inc hl	;Skip Instrument 0 Header.
0991: 23       [406]    	inc hl
0992: 22E904   [422]    	ld (_atVAR_Track1InstrumentPtr + 1), hl
0995: 227804   [438]    	ld (_atVAR_Track2InstrumentPtr + 1), hl
0998: 220E04   [454]    	ld (_atVAR_Track3InstrumentPtr + 1), hl
099B: C9       [464]    	ret
                        
                        
                        
                        	;Stop the music, cut the channels.
099C:                   atStop:
099C: 21BA05   [10]     	ld hl, _atVAR_Reg8	; Clear R8,R9 and R10 to zero
099F: 010003   [20]     	ld bc, $0300
09A2: 71       [27]     	ld (hl), c
09A3: 23       [33]     	inc hl
                        	; Z80> djnz $-2
09A4: 05       [37]     	dec b
09A5: C2A209   [47|47]  	jp nz,$-1-2
                        ; !!FLAGS djnz: dec b меняет Z/S/P
09A8: 3E3F     [54]     	ld a, %00111111	; Disable Tone and Noise on all channels
09AA: C33505   [64]     	jp _atAY3Update
                        
                        
                        	;*** Optionnal Sound effect API ************************************************
                        
                        	if atCNF_SFX
                        
                        	;Initialize the Sound Effects.
                        	; DE = SFX Music.
09AD:                   atSfxInit:
                        	;Find the Instrument Table.
09AD: 210C00   [10]     	ld hl, 12
09B0: 19       [21]     	add hl, de
09B1: 22F809   [37]     	ld (_atSfxPlay_InstrumentTable + 1), hl
                        
                        	;Clear the three channels of any sound effect.
09B4:                   atSfxStopAll:
09B4: 210000   [10]     	ld hl, 0
09B7: 220405   [26]     	ld (_atVAR_SfxTrack1_instrument + 1), hl
09BA: 229304   [42]     	ld (_atVAR_SfxTrack2_instrument + 1), hl
09BD: 222904   [58]     	ld (_atVAR_SfxTrack3_instrument + 1), hl
09C0: C9       [68]     	ret
                        
                        
0000:                   _atDEF_SfxOffset_pitch:	equ 0
0011:                   _atDEF_SfxOffset_volume:	equ _atVAR_SfxTrack1_volume		- _atVAR_SfxTrack1_pitch
0010:                   _atDEF_SfxOffset_note:	equ _atVAR_SfxTrack1_note		- _atVAR_SfxTrack1_pitch
0007:                   _atDEF_SfxOffset_instrument:	equ _atVAR_SfxTrack1_instrument		- _atVAR_SfxTrack1_pitch
002C:                   _atDEF_SfxOffset_speed:	equ _atVAR_SfxTrack1_instrumentSpeed	- _atVAR_SfxTrack1_pitch
0023:                   _atDEF_SfxOffset_speedCtr:	equ _atVAR_SfxTrack1_instrumentSpeedCtr	- _atVAR_SfxTrack1_pitch
                        
                        
                        	;Plays a Sound Effects along with the music.
                        	; Input
                        	;	A = No Channel (0,1,2)
                        	;	L = SFX Number (>0)
                        	;	H = Volume (0...F)
                        	;	E = Note (0...143)
                        	;	D = Speed (0 = As original, 1...255 = new Speed (1 is fastest))
                        	;	BC = Inverted Pitch (-#FFFF -> FFFF). 0 is no pitch. The higher the pitch, the lower the sound.
09C1:                   atSfxPlay:
                        	; Z80> ld ix, _atVAR_SfxTrack1_pitch
09C1: E5       [11]     	push hl
09C2: 21FC04   [21]     	ld hl,_atVAR_SfxTrack1_pitch
09C5: 22440D   [37]     	ld (z_ix),hl
09C8: E1       [47]     	pop hl
09C9: 3D       [51]     	dec a
09CA: FAE009   [61|61]  	jp m, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack2_pitch
09CD: E5       [72]     	push hl
09CE: 218B04   [82]     	ld hl,_atVAR_SfxTrack2_pitch
09D1: 22440D   [98]     	ld (z_ix),hl
09D4: E1       [108]    	pop hl
09D5: CAE009   [118|118]	jp z, _atSfxPlay_Selected
                        	; Z80> ld ix, _atVAR_SfxTrack3_pitch
09D8: E5       [129]    	push hl
09D9: 212104   [139]    	ld hl,_atVAR_SfxTrack3_pitch
09DC: 22440D   [155]    	ld (z_ix),hl
09DF: E1       [165]    	pop hl
                        
09E0:                   _atSfxPlay_Selected:
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 1), c	;Set Pitch
09E0: CD220C   [17]     	call z_ix_st_c
09E3: 01                	db _atDEF_SfxOffset_pitch + 1
                        	; Z80> ld (ix + _atDEF_SfxOffset_pitch + 2), b
09E4: CD0B0C   [34]     	call z_ix_st_b
09E7: 02                	db _atDEF_SfxOffset_pitch + 2
09E8: 7B       [38]     	ld a, e	;Set Note
                        	; Z80> ld (ix + _atDEF_SfxOffset_note), a
09E9: CDDD0B   [55]     	call z_ix_sta
09EC: 10                	db _atDEF_SfxOffset_note
09ED: 3E0F     [62]     	ld a, 15	;Set Volume
09EF: 94       [66]     	sub h
                        	; Z80> ld (ix + _atDEF_SfxOffset_volume), a
09F0: CDDD0B   [83]     	call z_ix_sta
09F3: 11                	db _atDEF_SfxOffset_volume
09F4: 2600     [90]     	ld h, 0	;Set Instrument Address
09F6: 29       [101]    	add hl, hl
09F7:                   _atSfxPlay_InstrumentTable:
09F7: 010000   [10]     	ld bc, 0
09FA: 09       [21]     	add hl, bc
09FB: 7E       [28]     	ld a, (hl)
09FC: 23       [34]     	inc hl
09FD: 66       [41]     	ld h, (hl)
09FE: 6F       [45]     	ld l, a
09FF: 7A       [49]     	ld a, d	;Read Speed or use the user's one ?
0A00: B7       [53]     	or a
0A01: C2050A   [63|63]  	jp nz, _atSfxPlay_UserSpeed
0A04: 7E       [70]     	ld a, (hl)	;Get Speed
0A05:                   _atSfxPlay_UserSpeed:
                        	; Z80> ld (ix + _atDEF_SfxOffset_speed + 1), a
0A05: CDDD0B   [17]     	call z_ix_sta
