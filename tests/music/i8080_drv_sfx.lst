087D: 7E       [167]    	ld a,(hl)
087E: 23       [173]    	inc hl
087F: 32EB0A   [186]    	ld (t2_transp),a
0882: 7E       [193]    	ld a,(hl)
0883: 23       [199]    	inc hl
0884: 32FC0A   [212]    	ld (t3_transp),a
0887: 7E       [219]    	ld a,(hl)
0888: 23       [225]    	inc hl
0889: 32960A   [238]    	ld (at_sptrack),a
088C: 7E       [245]    	ld a,(hl)
088D: 23       [251]    	inc hl
088E: 32970A   [264]    	ld (at_sptrack+1),a
0891: 22940A   [280]    	ld (at_linkptr),hl
0894: 3E01     [287]    	ld a,1
0896: 32910A   [300]    	ld (at_songctr),a
