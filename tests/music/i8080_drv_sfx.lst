0759: 78       [41]     	ld a, b	; rr b; rr b
075A: 1F       [45]     	rra
075B: 1F       [49]     	rra
075C: 47       [53]     	ld b, a
075D: 78       [57]     	ld a, b
075E: E604     [64]     	and 4	; ручная аппаратная частота?
0760: CD7B07   [81]     	call _atSound_getFrequency
0763: 22BF05   [97]     	ld (_atVAR_Reg11), hl
0766: 2AD807   [113]    	ld hl, (ps_iptr)
0769: 78       [117]    	ld a, b
076A: E620     [124]    	and $20	; шум?
076C: C8       [129|135]	ret z
076D: 7E       [136]    	ld a, (hl)
076E: 23       [142]    	inc hl
076F: 32B905   [155]    	ld (_atVAR_Reg6), a
0772: 3ADE07   [168]    	ld a, (ps_ixl)	; res 3,ixl
0775: E6F7     [175]    	and $F7
0777: 32DE07   [188]    	ld (ps_ixl), a
077A: C9       [198]    	ret
                        	; _atSound_getFrequency: Z=0 -> ручная частота (word) + TrackPitch; иначе по ноте:
                        	;   бит 4 B — питч инструмента (word, прибавляется к TrackPitch), бит 3 B — арпеджио (byte).
                        	; Вход: HL = инструмент, B = флаги, E = нота. Выход: HL = частота, ps_iptr = инструмент дальше.
                        	; Портит A, DE.
077B:                   _atSound_getFrequency:
077B: C2B907   [10|10]  	jp nz, _atSound_getFrequency_manual
077E:                   _atSound_calcFrequency:
077E: 78       [ 4]     	ld a, b
077F: E610     [11]     	and $10
0781: CA9607   [21|21]  	jp z, _atSound_calcFrequency_noPitch
0784: 7E       [28]     	ld a, (hl)	; питч инструмента -> TrackPitch (DE = громкость/нота — не трогать!)
0785: 23       [34]     	inc hl
0786: E5       [45]     	push hl
0787: 21D607   [55]     	ld hl, ps_pitch
078A: 86       [62]     	add a, (hl)
078B: 77       [69]     	ld (hl), a
078C: E1       [79]     	pop hl
078D: 7E       [86]     	ld a, (hl)
078E: 23       [92]     	inc hl
078F: E5       [103]    	push hl
0790: 21D707   [113]    	ld hl, ps_pitch+1
0793: 8E       [120]    	adc a, (hl)	; CY от первого add: push/pop/ld hl,nn флаги не трогают
0794: 77       [127]    	ld (hl), a
0795: E1       [137]    	pop hl
0796:                   _atSound_calcFrequency_noPitch:
0796: 78       [ 4]     	ld a, b
0797: E608     [11]     	and $08
0799: 7B       [15]     	ld a, e	; нота (and не трогает A? трогает — поэтому флаг проверяем сразу)
079A: CAA607   [25|25]  	jp z, _atSound_calcFrequency_noArp
079D: 86       [32]     	add a, (hl)	; + арпеджио
079E: 23       [38]     	inc hl
079F: FE90     [45]     	cp 144
07A1: DAA607   [55|55]  	jp c, _atSound_calcFrequency_noArp
07A4: 3E8F     [62]     	ld a, 143
07A6:                   _atSound_calcFrequency_noArp:
07A6: 22D807   [16]     	ld (ps_iptr), hl
07A9: 6F       [20]     	ld l, a
07AA: 2600     [27]     	ld h, 0
07AC: 29       [38]     	add hl, hl
07AD: 112008   [48]     	ld de, _atLUT_notePeriods
07B0: 19       [59]     	add hl, de
07B1: 5E       [66]     	ld e, (hl)
07B2: 23       [72]     	inc hl
07B3: 56       [79]     	ld d, (hl)
07B4: 2AD607   [95]     	ld hl, (ps_pitch)
07B7: 19       [106]    	add hl, de	; период + TrackPitch (+ питч инструмента)
07B8: C9       [116]    	ret
07B9:                   _atSound_getFrequency_manual:
07B9: 5E       [ 7]     	ld e, (hl)	; ручная частота + TrackPitch
07BA: 23       [13]     	inc hl
07BB: 56       [20]     	ld d, (hl)
07BC: 23       [26]     	inc hl
07BD: 22D807   [42]     	ld (ps_iptr), hl
07C0: 2AD607   [58]     	ld hl, (ps_pitch)
07C3: 19       [69]     	add hl, de
07C4: C9       [79]     	ret
                        	; ps_sra2: HL >>= 2 арифметически (sra h / rr l дважды)
07C5:                   ps_sra2:
07C5: 7C       [ 4]     	ld a, h
07C6: 17       [ 8]     	rla
07C7: 7C       [12]     	ld a, h
07C8: 1F       [16]     	rra
07C9: 67       [20]     	ld h, a
07CA: 7D       [24]     	ld a, l
07CB: 1F       [28]     	rra
07CC: 6F       [32]     	ld l, a
07CD: 7C       [36]     	ld a, h
07CE: 17       [40]     	rla
07CF: 7C       [44]     	ld a, h
07D0: 1F       [48]     	rra
07D1: 67       [52]     	ld h, a
07D2: 7D       [56]     	ld a, l
07D3: 1F       [60]     	rra
07D4: 6F       [64]     	ld l, a
07D5: C9       [74]     	ret
                        	; ячейки нативного плеера
07D6: 0000              ps_pitch:	dw 0	; DE' — TrackPitch
07D8: 0000              ps_iptr:	dw 0	; указатель инструмента на время расчёта частоты
07DA: 0000              ps_freqp:	dw 0	; IY -> частота канала
07DC: 0000              ps_volp:	dw 0	; IY+7 -> громкость канала
07DE: 00                ps_ixl:	db 0	; флаги R7 канала
07DF: 00                ps_ixh:	db 0	; сохранённая нота
07E0: 00                ps_r7:	db 0	; AF' — сборка R7
                        
                        	; Read Track.
                        	; Input:
                        	;	HL=Track Pointer.
                        
                        	; Output:
                        	;	HL = Updated Track Pointer.
                        	;	Carry = 1 => Wait A lines.
                        	;		then A = Wait (0(=256)-127)
                        	;	Carry = 0 => Line not empty.
                        	;	 D = Parameters + Volume.
                        	;	 E = Note
                        	;	 B = Instrument. 0=RST
                        	;	IX = PitchAdd. Only used if Pitch? = 1.
07E1:                   _atReadTrack:
07E1: 7E       [ 7]     	ld a, (hl)
07E2: 23       [13]     	inc hl
                        	; Z80> srl a	;Full Optimisation ? If yes = Note only, no Pitch, no Volume, Same Instrument.
07E3: B7       [17]     	or a
07E4: 1F       [21]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
07E5: DA1608   [31|31]  	jp c, _atReadTrack_FullOptimisation
07E8: D620     [38]     	sub 32	;0-31 = Wait.
07EA: DA1308   [48|48]  	jp c, _atReadTrack_Wait
07ED: C2F307   [58|58]  	jp nz, _atReadTrack_NoEscapeCode
07F0: 7E       [65]     	ld a, (hl)
07F1: 23       [71]     	inc hl
07F2: 3C       [75]     	inc a
07F3:                   _atReadTrack_NoEscapeCode:
07F3: 3D       [ 4]     	dec a	;0 (32-32) = Escape Code for more Notes (parameters will be read)
07F4: 5F       [ 8]     	ld e, a	;Save Note.
                        
                        	;Read Parameters
07F5:                   _atReadTrack_ReadParameters:
07F5: 7E       [ 7]     	ld a, (hl)
07F6: 57       [11]     	ld d, a	;Save Parameters.
07F7: 23       [17]     	inc hl
07F8: 17       [21]     	rla	;Pitch ?
07F9: D20C08   [31|31]  	jp nc, _atReadTrack_Pitch_End
07FC: 46       [38]     	ld b, (hl)	;Get PitchAdd
                        	; Z80> ld ixl, b
07FD: F5       [49]     	push af
07FE: 78       [53]     	ld a,b
07FF: 32440D   [66]     	ld (z_ix),a
0802: F1       [76]     	pop af
0803: 23       [82]     	inc hl
0804: 46       [89]     	ld b, (hl)
                        	; Z80> ld ixh, b
0805: F5       [100]    	push af
0806: 78       [104]    	ld a,b
0807: 32450D   [117]    	ld (z_ix+1),a
080A: F1       [127]    	pop af
080B: 23       [133]    	inc hl
080C:                   _atReadTrack_Pitch_End:
080C: 17       [ 4]     	rla	;Skip IsNote? flag.
080D: 17       [ 8]     	rla	;New Instrument ?
080E: D0       [13|19]  	ret nc
080F: 46       [20]     	ld b, (hl)
0810: 23       [26]     	inc hl
0811: B7       [30]     	or a	;Remove Carry, as the player interpret it as a Wait command.
0812: C9       [40]     	ret
                        
0813:                   _atReadTrack_Wait:
0813: C620     [ 7]     	add a, 32
0815: C9       [17]     	ret
0816:                   _atReadTrack_FullOptimisation:
                        	;Note only, no Pitch, no Volume, Same Instrument.
0816: 1640     [ 7]     	ld d, %01000000	;[7] Note only.
0818: D601     [14]     	sub 1	;[7]
081A: 5F       [18]     	ld e, a	;[4]
081B: D0       [23|29]  	ret nc	;[5/11]
081C: 5E       [30]     	ld e, (hl)	;[7] Escape Code found (0). Read Note.
081D: 23       [36]     	inc hl	;[6]
081E: B7       [40]     	or a	;[4]
081F: C9       [50]     	ret	;[10]
                        
                        
