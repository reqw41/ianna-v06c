                        ; медленная ветка питча: питч трека += приращение, ps_pitch = питч >> 2 (арифметически).
0323:                   ch3_pslow:
0323: 21F40A   [10]     	ld hl,t3_pitch
0326: CD3E03   [27]     	call ps_pitchcalc
0329: C3A901   [37]     	jp ch3_pgo
032C:                   ch2_pslow:
032C: 21E30A   [10]     	ld hl,t2_pitch
032F: CD3E03   [27]     	call ps_pitchcalc
0332: C32902   [37]     	jp ch2_pgo
0335:                   ch1_pslow:
0335: 21D20A   [10]     	ld hl,t1_pitch
0338: CD3E03   [27]     	call ps_pitchcalc
033B: C3AD02   [37]     	jp ch1_pgo
                        
                        ; HL -> tN_pitch (dw питч, dw приращение). Ниже 7 % каналокадров — скорость не важна.
033E:                   ps_pitchcalc:
033E: 22A50A   [16]     	ld (ps_pblk),hl
0341: 5E       [23]     	ld e,(hl)
0342: 23       [29]     	inc hl
0343: 56       [36]     	ld d,(hl)
0344: 23       [42]     	inc hl
0345: 7E       [49]     	ld a,(hl)
0346: 23       [55]     	inc hl
0347: 66       [62]     	ld h,(hl)
0348: 6F       [66]     	ld l,a				; HL = приращение
0349: 19       [77]     	add hl,de
034A: EB       [81]     	ex de,hl			; DE = новый питч
034B: 2AA50A   [97]     	ld hl,(ps_pblk)
034E: 73       [104]    	ld (hl),e
034F: 23       [110]    	inc hl
0350: 72       [117]    	ld (hl),d
0351: EB       [121]    	ex de,hl			; HL = питч
0352: 7C       [125]    	ld a,h				; >>1 арифметически
0353: 17       [129]    	rla
0354: 7C       [133]    	ld a,h
0355: 1F       [137]    	rra
0356: 67       [141]    	ld h,a
0357: 7D       [145]    	ld a,l
0358: 1F       [149]    	rra
0359: 6F       [153]    	ld l,a
035A: 7C       [157]    	ld a,h				; ещё раз
035B: 17       [161]    	rla
035C: 7C       [165]    	ld a,h
035D: 1F       [169]    	rra
035E: 67       [173]    	ld h,a
035F: 7D       [177]    	ld a,l
0360: 1F       [181]    	rra
0361: 6F       [185]    	ld l,a
0362: 22A30A   [201]    	ld (ps_pitch),hl
0365: C9       [211]    	ret
                        
                        ;;; ============================== вывод в AY ==============================
                        ; Вход: A = значение регистра 7 (сборка из битов каналов).
0366:                   at_ay3update:
0366: E6BF     [ 7]     	and $BF				; бит 6 = 0, бит 7 = 1 (как в оригинале)
