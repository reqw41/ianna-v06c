                        ;;; --------------------------- расчёт частоты ---------------------------
                        ; ps_getfreq: Z = 1 -> частота по ноте, иначе ручная (word из инструмента).
                        ; Вход:  HL = указатель инструмента, B = флаги (бит 5 питч инструмента, бит 4 арпеджио), E = нота.
                        ; Выход: HL = частота, DE = указатель инструмента (регистры переставлены!). Портит A, B, C, DE.
04F5:                   ps_getfreq:
04F5: C22F05   [10|10]  	jp nz,ps_manualfreq
04F8:                   ps_calcfreq:
04F8: 78       [ 4]     	ld a,b
04F9: E620     [11]     	and $20				; питч инструмента (word) прибавляется к питчу трека
04FB: CA1205   [21|21]  	jp z,ps_cf_nopitch
04FE: 7E       [28]     	ld a,(hl)
04FF: 23       [34]     	inc hl
0500: 4F       [38]     	ld c,a
0501: 3AA309   [51]     	ld a,(ps_pitch)
0504: 81       [55]     	add a,c
0505: 32A309   [68]     	ld (ps_pitch),a
0508: 7E       [75]     	ld a,(hl)			; перенос переживает ld a,(hl)/inc hl/ld c,a/ld a,(nn) — флаги не трогают
0509: 23       [81]     	inc hl
050A: 4F       [85]     	ld c,a
050B: 3AA409   [98]     	ld a,(ps_pitch+1)
050E: 89       [102]    	adc a,c
050F: 32A409   [115]    	ld (ps_pitch+1),a
0512:                   ps_cf_nopitch:
