                        ; --------------------------------------
                        ; zasm: assemble "i8080_drv_sfx.asm"
                        ; opts: --8080
                        ; date: 2026-09-01 13:40:33
                        ; --------------------------------------


                        ; Стенд переведённого плеера Arkos на i8080: песня по $C980, эффекты по $D980 (обычная память).
                        ; Каждый кадр: atPlay; out ($FF) = маркер кадра. Через 600 кадров halt.
0100:                   	org $0100
0100: C30301   [10]     	jp start
0000:                   DEMO	equ 0
000A:                   VDP_NY	equ 10
0028:                   MUSIC_ROM_PAGE equ 40
0103:                   start:
0103: F3       [ 4]     	di
0104: 31007F   [14]     	ld sp,$7F00
0107: 1180C9   [24]     	ld de,$C980
010A: CD4009   [41]     	call atInit
010D: 1180D9   [51]     	ld de,$D980
0110: CDAD09   [68]     	call atSfxInit
0113: 210000   [78]     	ld hl,0
0116:                   loop:
0116: E5       [11]     	push hl
0117: CD9E01   [28]     	call atPlay
011A: E1       [38]     	pop hl
                        
                        	; эффекты: таблица (кадр lo, hi, номер); канал 1, громкость 15, нота 36 — как FX_Play
011B: E5       [49]     	push hl
011C: 116501   [59]     	ld de,sfx_tab
011F:                   trig_l:
011F: 13       [ 6]     	inc de
0120: 13       [12]     	inc de
0121: 1A       [19]     	ld a,(de)
0122: B7       [23]     	or a
0123: CA5201   [33|33]  	jp z,trig_end
0126: 1B       [39]     	dec de
0127: 1B       [45]     	dec de
0128: 1A       [52]     	ld a,(de)
0129: BD       [56]     	cp l
012A: C24C01   [66|66]  	jp nz,trig_n
012D: 13       [72]     	inc de
012E: 1A       [79]     	ld a,(de)
012F: 1B       [85]     	dec de
0130: BC       [89]     	cp h
0131: C24C01   [99|99]  	jp nz,trig_n
0134: 13       [105]    	inc de
0135: 13       [111]    	inc de
0136: 1A       [118]    	ld a,(de)
0137: 1B       [124]    	dec de
0138: 1B       [130]    	dec de
0139: D5       [141]    	push de
013A: E5       [152]    	push hl
013B: 6F       [156]    	ld l,a
013C: 3E01     [163]    	ld a,1
013E: 260F     [170]    	ld h,15
0140: 1E24     [177]    	ld e,36
0142: 1600     [184]    	ld d,0
0144: 010000   [194]    	ld bc,0
0147: CDC109   [211]    	call atSfxPlay
014A: E1       [221]    	pop hl
014B: D1       [231]    	pop de
014C:                   trig_n:
014C: 13       [ 6]     	inc de
014D: 13       [12]     	inc de
014E: 13       [18]     	inc de
014F: C31F01   [28]     	jp trig_l
0152:                   trig_end:
0152: E1       [10]     	pop hl
0153: 3EFF     [17]     	ld a,$FF
0155: D3FF     [28]     	out ($FF),a
0157: 23       [34]     	inc hl
0158: 7C       [38]     	ld a,h
0159: FE18     [45]     	cp 6200/256
015B: C21601   [55|55]  	jp nz,loop
015E: 7D       [59]     	ld a,l
015F: FE38     [66]     	cp 6200 & 255
0161: C21601   [76|76]  	jp nz,loop
0164: 76       [80]     	halt
0165:                   sfx_tab:
0165: 640001            	db 100,0,1
0168: 2C0102            	db 44,1,2
016B: BC0203            	db 188,2,3
016E: B00404            	db 176,4,4
0171: DC0505            	db 220,5,5
0174: E60506            	db 230,5,6
0177: D00707            	db 208,7,7
017A: 280A01            	db 40,10,1
017D: E40C03            	db 228,12,3
0180: 041002            	db 4,16,2
0183: 881305            	db 136,19,5
0186: 701704            	db 112,23,4
0189: 000000            	db 0,0,0
                        #include "../../build/tr/arkos.asm"
                        ; ==== arkos_src.asm -> i8080 (z80to8080.py) ====
                        
                        	; ВЕКТОР: org снят — плеер на месте в коде
                        
                        	; Arkos Tracker Player V1.0 - Spectrum / Pentagon version.
                        	;   Code by Targhan/Arkos
                        	;   Speccy port / source re-layout by Grim/Arkos
                        	;
                        	; Compile fine with Pasmo v0.5.4.beta2
                        	; Manual and informations available at http://arkostracker.cpcscene.com/
                        	; I know, I know... I'm a tab-indent-zealot =)
                        
                        	;*** Configuration switches ****************************************************
                        
                        	; Switch between Speccy or Pentagon AY3 Tone table
                        	; 1 = Spectrum / any other value = Pentagon
0001:                   atCNF_ZXPT:	equ 1
                        
                        	; Enable/Disable sound effect support.
                        	; 0 = Disabled / any other value = Enabled
0001:                   atCNF_SFX:	equ 1
                        
                        	; Enable/Disable volume fade support.
                        	; 0 = Disabled / any other value = Enabled
0000:                   atCNF_FADE:	equ 0
                        
                        	;*** Player API ****************************************************************
                        
                        	; Initialize the player
                        	; - Routine: atInit
                        	; - Input:
                        	;	DE = Song data address
                        
                        	; Play one tick of the music
                        	; - Routine: atPlay
                        	; - Output:
                        	;	_All_ CPU registers might be modified.
                        
                        	; Stop all sounds (reset the AY3)
                        	; - Routine: atStop
                        
                        	;*** Optionnal sound effect API ************************************************
                        
                        	; Initialize sound effects
                        	; - Routine: atSfxInit
                        	; - Input:
                        	;	DE = Song data address
                        
                        	; Trigger a sound effect on a channel
                        	; - Routine: atSfxPlay
                        	; - Input:
                        	;	 A = Channel (0,1 or 2)
                        	;	 L = Sound effect number (>0)
                        	;	 H = Volume (0 to 15)
                        	;	 E = Note key (0 to 143)
                        	;	 D = Speed
                        	;	BC = Pitch offset
                        	; If the speed parameter is 0, the original intrument speed is used. Any value between
                        	; 1 and 255 will over-ride the default speed (1 being the fastest).
                        
                        	; Stop any sound effect on a given channel
                        	; - Routine: atSfxStop
                        	; - Input:
                        	;	A = Channel (0,1 or 2)
                        
                        
                        	; Stop sound effect on all the 3 channels.
                        	; - Routine: atSfxStopAll
                        
                        	;*** Optionnal fade API ********************************************************
                        
                        	; Set the amount by which the song volume is decreased.
                        	; - Routine: atFade
                        	; - Input:
                        	;	A = volume decrease (0 = no fade, 15+ = enjoy the silence)
                        
                        
                        	;*** Player mighty code ********************************************************
                        
                        	; Internal constant, do not change
00FE:                   _atDEF_R13RetrigValue:	equ $FE
                        
                        	; Added by utopian to have a simple SFX interface
018C: C34009   [10]     	jp atInit	;Call Player = Initialise song (DE = Song address).
018F: C39E01   [20]     	jp atPlay	;Call Player + 3 = Play song.
0192: C39C09   [30]     	jp atStop	;Call Player + 6 = Stop song.
0195: C3AD09   [40]     	jp atSfxInit	;Call Player + 9 to initialise the sound effect music.
0198: C3C109   [50]     	jp atSfxPlay	;Call Player + 12 to play an effect
019B: C3B409   [60]     	jp atSfxStopAll	;Call Player + 15 to stop all sound effects.
                        
                        
019E:                   atPlay:
019E: AF       [ 4]     	xor a
019F: 32BB05   [17]     	ld (_atVAR_digidrum), a	;Reset the Digidrum flag.
                        
                        	; If Speed counter is over, we have to read the Pattern further.
01A2:                   _atVAR_SongSpeedCtr:
01A2: 3E01     [ 7]     	ld a, 1
01A4: 3D       [11]     	dec a
01A5: C2EB03   [21|21]  	jp nz, _atSetSongSpeedCtr
                        
                        	; Do we have to move to the next song position or continue in the same pattern?
01A8:                   _atVAR_patternHeightCtr:
01A8: 3E01     [ 7]     	ld a, 1
01AA: 3D       [11]     	dec a
01AB: C22902   [21|21]  	jp nz, _atSetPatternHeightCtr
                        
                        	; Pattern Over. We have to read the Linker.
                        	; Get the Transpositions, if they have changed,
                        	; or detect the Song Ending !
                        
01AE:                   _atVAR_Linker:
01AE: 210000   [10]     	ld hl, 0
01B1: 7E       [17]     	ld a, (hl)
01B2: 23       [23]     	inc hl
01B3: 1F       [27]     	rra
01B4: D2BE01   [37|37]  	jp nc, _atSongContinue
                        	; Get the song loop position
01B7: 7E       [44]     	ld a, (hl)
01B8: 23       [50]     	inc hl
01B9: 66       [57]     	ld h, (hl)
01BA: 6F       [61]     	ld l, a
01BB: 7E       [68]     	ld a, (hl)	; We know the Song won't restart now,
01BC: 23       [74]     	inc hl	; so we can skip the first bit.
01BD: 1F       [78]     	rra
01BE:                   _atSongContinue:
01BE: 1F       [ 4]     	rra
01BF: D2C801   [14|14]  	jp nc, _atKeepTrCh1
01C2: 119502   [24]     	ld de, _atVAR_TranspCh1 + 1
                        	; Z80> ldi 
01C5: CD120D   [41]     	call z_ldi
01C8:                   _atKeepTrCh1:
01C8: 1F       [ 4]     	rra
01C9: D2D201   [14|14]  	jp nc, _atKeepTrCh2
01CC: 111B03   [24]     	ld de, _atVAR_TranspCh2 + 1
                        	; Z80> ldi 
01CF: CD120D   [41]     	call z_ldi
01D2:                   _atKeepTrCh2:
01D2: 1F       [ 4]     	rra
01D3: D2DC01   [14|14]  	jp nc, _atKeepTrCh3
01D6: 11A103   [24]     	ld de, _atVAR_TranspCh3 + 1
                        	; Z80> ldi 
01D9: CD120D   [41]     	call z_ldi
01DC:                   _atKeepTrCh3:
                        	; Get the Tracks addresses.
01DC: 115E02   [10]     	ld de, _atVAR_Track1Ptr + 1
                        	; Z80> ldi 
01DF: CD120D   [27]     	call z_ldi
                        	; Z80> ldi 
01E2: CD120D   [44]     	call z_ldi
01E5: 11E402   [54]     	ld de, _atVAR_Track2Ptr + 1
                        	; Z80> ldi 
01E8: CD120D   [71]     	call z_ldi
                        	; Z80> ldi 
01EB: CD120D   [88]     	call z_ldi
01EE: 116A03   [98]     	ld de, _atVAR_Track3Ptr + 1
                        	; Z80> ldi 
01F1: CD120D   [115]    	call z_ldi
                        	; Z80> ldi 
01F4: CD120D   [132]    	call z_ldi
                        
                        	; Get the Special Track address, if it has changed.
01F7: 1F       [136]    	rra
01F8: D20102   [146|146]	jp nc, _atKeepPatternHeight
01FB: 112802   [156]    	ld de, _atVAR_PatternHeight + 1
                        	; Z80> ldi 
01FE: CD120D   [173]    	call z_ldi
0201:                   _atKeepPatternHeight:
0201: 1F       [ 4]     	rra
0202: D21002   [14|14]  	jp nc, _atReplaySpecialTrack
                        	; Load a new special track
0205: 5E       [21]     	ld e, (hl)
0206: 23       [27]     	inc hl
0207: 56       [34]     	ld d, (hl)
0208: 23       [40]     	inc hl
                        	; Z80> ld (_atVAR_SpecialTrackAddr + 1), de
0209: E5       [51]     	push hl
020A: EB       [55]     	ex de,hl
020B: 221402   [71]     	ld (_atVAR_SpecialTrackAddr + 1),hl
020E: EB       [75]     	ex de,hl
020F: E1       [85]     	pop hl
0210:                   _atReplaySpecialTrack:
0210: 22AF01   [16]     	ld (_atVAR_Linker + 1), hl
0213:                   _atVAR_SpecialTrackAddr:
0213: 210000   [10]     	ld hl, 0
0216: 223302   [26]     	ld (_atVAR_SpecialTrackPtr + 1), hl
                        
                        	; Reset the SpecialTrack/Tracks line counter.
                        	; We can't rely on the song data, because the
                        	; Pattern Height is not related to the Tracks Height.
0219: 3E01     [33]     	ld a, 1
021B: 322D02   [46]     	ld (_atVAR_WaitSpecialTrack + 1), a
021E: 325802   [59]     	ld (_atVAR_WaitTrack1 + 1), a
0221: 32DE02   [72]     	ld (_atVAR_WaitTrack2 + 1), a
0224: 326403   [85]     	ld (_atVAR_WaitTrack3 + 1), a
                        
0227:                   _atVAR_PatternHeight:
0227: 3E01     [ 7]     	ld a, 1
0229:                   _atSetPatternHeightCtr:
0229: 32A901   [13]     	ld (_atVAR_patternHeightCtr + 1), a
                        
                        
                        	;*** Read Special Track ********************************************************
                        
022C:                   _atVAR_WaitSpecialTrack:
022C: 3E01     [ 7]     	ld a, 1
022E: 3D       [11]     	dec a
022F: C25402   [21|21]  	jp nz, _atSpecialTrackWait
                        
0232:                   _atVAR_SpecialTrackPtr:
0232: 210000   [10]     	ld hl, 0
0235: 7E       [17]     	ld a, (hl)
0236: 23       [23]     	inc hl
                        	; Z80> srl a	;Data (1) or Wait (0) ?
0237: B7       [27]     	or a
0238: 1F       [31]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
0239: D25102   [41|41]  	jp nc, _atSpecialTrack_waitCmd	;If Wait, A contains the Wait value.
                        	; Z80> srl a	;Speed (0) or Digidrum (1) ?
023C: B7       [45]     	or a
023D: 1F       [49]     	rra
                        ; !!FLAGS srl: нет Z/S/P (только CY)
                        	; First, we don't test the Effect Type, but only the Escape Code (=0)
023E: C24302   [59|59]  	jp nz, _atSpecialTrackNoEscCode
0241: 7E       [66]     	ld a, (hl)
0242: 23       [72]     	inc hl
0243:                   _atSpecialTrackNoEscCode:
                        	; Now, we test the Effect type, since the Carry didn't change.
0243: D24C02   [10|10]  	jp nc, _atSpecialTrack_speedCmd
0246: 32BB05   [23]     	ld (_atVAR_digidrum), a
0249: C34F02   [33]     	jp _atSpecialTrack_proceed
024C:                   _atSpecialTrack_speedCmd:
024C: 32EA03   [13]     	ld (_atVAR_SongSpeed + 1), a
024F:                   _atSpecialTrack_proceed:
024F: 3E01     [ 7]     	ld a, 1
0251:                   _atSpecialTrack_waitCmd:
0251: 223302   [16]     	ld (_atVAR_SpecialTrackPtr + 1), hl
0254:                   _atSpecialTrackWait:
0254: 322D02   [13]     	ld (_atVAR_WaitSpecialTrack + 1), a
                        
                        
                        	;*** Read Track 1 **************************************************************
                        
0257:                   _atVAR_WaitTrack1:
0257: 3E01     [ 7]     	ld a, 1
0259: 3D       [11]     	dec a
025A: C2DA02   [21|21]  	jp nz, _atTrack1Wait
                        
                        
025D:                   _atVAR_Track1Ptr:
025D: 210000   [10]     	ld hl, 0
0260: CDE107   [27]     	call _atReadTrack
0263: 225E02   [43]     	ld (_atVAR_Track1Ptr + 1), hl
0266: DADA02   [53|53]  	jp c, _atTrack1Wait
                        
                        	; No Wait command. Can be a Note and/or Effects.
0269: 7A       [57]     	ld a, d	; Make a copy of the flags+Volume in A, not to temper with the original.
026A: 1F       [61]     	rra	; Volume ? If bit 4 was 1, then volume exists on b3-b0
026B: D27302   [71|71]  	jp nc, _atTrack1_keepVolume
026E: E60F     [78]     	and %1111
0270: 32E704   [91]     	ld (_atVAR_Track1Volume), a
0273:                   _atTrack1_keepVolume:
                        	; Z80> rl d	; New Pitch ?
0273: 32480D   [13]     	ld (z_a),a
0276: 7A       [17]     	ld a,d
0277: 17       [21]     	rla
0278: 57       [25]     	ld d,a
0279: 3A480D   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
027C: D28702   [48|48]  	jp nc, _atTrack1_keepPitch
                        	; Z80> ld (_atVAR_Track1PitchAdd + 1), ix
027F: E5       [59]     	push hl
0280: 2A440D   [75]     	ld hl,(z_ix)
0283: 22D904   [91]     	ld (_atVAR_Track1PitchAdd + 1),hl
0286: E1       [101]    	pop hl
0287:                   _atTrack1_keepPitch:
                        	; Z80> rl d	; Note ? If no Note, we don't have to test if a new Instrument is here.
0287: 32480D   [13]     	ld (z_a),a
028A: 7A       [17]     	ld a,d
028B: 17       [21]     	rla
028C: 57       [25]     	ld d,a
028D: 3A480D   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
0290: D2D802   [48|48]  	jp nc, _atTrack1_keepNote
0293: 7B       [52]     	ld a, e
                        	; Transpose Note according to the Transposition in the Linker.
0294:                   _atVAR_TranspCh1:
0294: C600     [ 7]     	add a, 0
0296: 32E604   [20]     	ld (_atVAR_Track1Note), a
                        	; Reset the TrackPitch.
0299: 210000   [30]     	ld hl, 0
029C: 22D604   [46]     	ld (_atVAR_Track1Pitch + 1), hl
                        	; New Instrument ?
                        	; Z80> rl d
029F: 32480D   [59]     	ld (z_a),a
02A2: 7A       [63]     	ld a,d
02A3: 17       [67]     	rla
02A4: 57       [71]     	ld d,a
02A5: 3A480D   [84]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
02A8: DAB702   [94|94]  	jp c, _atTrack1LoadInstrument
                        	; Same Instrument. We recover its address to restart it.
02AB:                   _atVAR_Track1InstAddr:
02AB: 210000   [10]     	ld hl, 0
02AE: 3AF804   [23]     	ld a, (_atVAR_Track1InstSpeed + 1)
02B1: 32EF04   [36]     	ld (_atVAR_Track1InstSpeedCtr + 1), a
02B4: C3D502   [46]     	jp _atTrack1SetInstrumentPtr
                        
02B7:                   _atTrack1LoadInstrument:	; New Instrument. We have to get its new address, and Speed.
02B7: 68       [ 4]     	ld l, b	; H is already set to 0 before.
02B8: 29       [15]     	add hl, hl
02B9:                   _atVAR_Track1InstrumentLUT:
02B9: 010000   [10]     	ld bc, 0
02BC: 09       [21]     	add hl, bc
02BD: 7E       [28]     	ld a, (hl)	; Get Instrument address.
02BE: 23       [34]     	inc hl
02BF: 66       [41]     	ld h, (hl)
02C0: 6F       [45]     	ld l, a
02C1: 7E       [52]     	ld a, (hl)	; Get Instrument speed.
02C2: 23       [58]     	inc hl
02C3: 32F804   [71]     	ld (_atVAR_Track1InstSpeed + 1), a
02C6: 32EF04   [84]     	ld (_atVAR_Track1InstSpeedCtr + 1), a
02C9: 7E       [91]     	ld a, (hl)
02CA: B7       [95]     	or a	; Get IsRetrig?. Code it only if different to 0, else next Instruments are going to overwrite it.
02CB: CAD102   [105|105]	jp z, $+1+5
02CE: 32AB05   [118]    	ld (_atVAR_R13Lock + 1), a	; Poke &FE as previous R13 value
02D1: 23       [124]    	inc hl
02D2: 22AC02   [140]    	ld (_atVAR_Track1InstAddr + 1), hl	; When using the Instrument again, no need to give the Speed, it is skipped.
02D5:                   _atTrack1SetInstrumentPtr:
02D5: 22E904   [16]     	ld (_atVAR_Track1InstrumentPtr + 1), hl
02D8:                   _atTrack1_keepNote:
02D8: 3E01     [ 7]     	ld a, 1
02DA:                   _atTrack1Wait:
02DA: 325802   [13]     	ld (_atVAR_WaitTrack1 + 1), a
                        
                        
                        	;*** Read Track 2 **************************************************************
                        
02DD:                   _atVAR_WaitTrack2:
02DD: 3E01     [ 7]     	ld a, 1
02DF: 3D       [11]     	dec a
02E0: C26003   [21|21]  	jp nz, _atTrack2Wait
                        
                        
02E3:                   _atVAR_Track2Ptr:
02E3: 210000   [10]     	ld hl, 0
02E6: CDE107   [27]     	call _atReadTrack
02E9: 22E402   [43]     	ld (_atVAR_Track2Ptr + 1), hl
02EC: DA6003   [53|53]  	jp c, _atTrack2Wait
                        
                        	; No Wait command. Can be a Note and/or Effects.
                        	; Make a copy of the flags+Volume in A, not to temper with the original.
02EF: 7A       [57]     	ld a, d
02F0: 1F       [61]     	rra	; Volume ? If bit 4 was 1, then volume exists on b3-b0
02F1: D2F902   [71|71]  	jp nc, _atTrack2_keepVolume
02F4: E60F     [78]     	and %1111
02F6: 327604   [91]     	ld (_atVAR_Track2Volume), a
02F9:                   _atTrack2_keepVolume:
                        	; Z80> rl d	; New Pitch ?
02F9: 32480D   [13]     	ld (z_a),a
02FC: 7A       [17]     	ld a,d
02FD: 17       [21]     	rla
02FE: 57       [25]     	ld d,a
02FF: 3A480D   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
0302: D20D03   [48|48]  	jp nc, _atTrack2_keepPitch
                        	; Z80> ld (_atVAR_Track2PitchAdd + 1), ix
0305: E5       [59]     	push hl
0306: 2A440D   [75]     	ld hl,(z_ix)
0309: 226804   [91]     	ld (_atVAR_Track2PitchAdd + 1),hl
030C: E1       [101]    	pop hl
030D:                   _atTrack2_keepPitch:
                        
                        	; Z80> rl d	; Note ? If no Note, we don't have to test if a new Instrument is here.
030D: 32480D   [13]     	ld (z_a),a
0310: 7A       [17]     	ld a,d
0311: 17       [21]     	rla
0312: 57       [25]     	ld d,a
0313: 3A480D   [38]     	ld a,(z_a)
                        ; !!FLAGS rl: нет Z/S/P (только CY)
0316: D25E03   [48|48]  	jp nc, _atTrack2_keepNote
                        
                        	; Transpose Note according to the Transposition in the Linker.
0319: 7B       [52]     	ld a, e
031A:                   _atVAR_TranspCh2:
031A: C600     [ 7]     	add a, 0
031C: 327504   [20]     	ld (_atVAR_Track2Note), a
                        	; Reset the TrackPitch.
031F: 210000   [30]     	ld hl, 0
0322: 226504   [46]     	ld (_atVAR_Track2Pitch + 1), hl
                        	; New Instrument ?
                        	; Z80> rl d
0325: 32480D   [59]     	ld (z_a),a
0328: 7A       [63]     	ld a,d
0329: 17       [67]     	rla
032A: 57       [71]     	ld d,a
