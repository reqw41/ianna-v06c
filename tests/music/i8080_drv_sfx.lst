                        ; Стенд переведённого плеера Arkos на i8080: песня по $C980, эффекты по $D980 (обычная память).
                        ; Каждый кадр: atPlay; out ($FF) = маркер кадра. Через 600 кадров halt.
0100:                   	org $0100
0100: C30301   [10]     	jp start
0000:                   DEMO	equ 0
000A:                   VDP_NY	equ 10
0028:                   MUSIC_ROM_PAGE equ 40
0103:                   start:
0103: F3       [ 4]     	di
0104: 31007F   [14]     	ld sp,$7F00
0107: 1180C9   [24]     	ld de,$C980
010A: CD6008   [41]     	call atInit
010D: 1180D9   [51]     	ld de,$D980
0110: CDC008   [68]     	call atSfxInit
0113: 210000   [78]     	ld hl,0
0116:                   loop:
0116: E5       [11]     	push hl
0117: CD8C01   [28]     	call atPlay
011A: E1       [38]     	pop hl
                        
                        	; эффекты: таблица (кадр lo, hi, номер); канал 1, громкость 15, нота 36 — как FX_Play
011B: E5       [49]     	push hl
011C: 116501   [59]     	ld de,sfx_tab
011F:                   trig_l:
011F: 13       [ 6]     	inc de
0120: 13       [12]     	inc de
0121: 1A       [19]     	ld a,(de)
0122: B7       [23]     	or a
0123: CA5201   [33|33]  	jp z,trig_end
0126: 1B       [39]     	dec de
0127: 1B       [45]     	dec de
0128: 1A       [52]     	ld a,(de)
0129: BD       [56]     	cp l
012A: C24C01   [66|66]  	jp nz,trig_n
012D: 13       [72]     	inc de
012E: 1A       [79]     	ld a,(de)
012F: 1B       [85]     	dec de
0130: BC       [89]     	cp h
0131: C24C01   [99|99]  	jp nz,trig_n
0134: 13       [105]    	inc de
0135: 13       [111]    	inc de
0136: 1A       [118]    	ld a,(de)
0137: 1B       [124]    	dec de
0138: 1B       [130]    	dec de
0139: D5       [141]    	push de
013A: E5       [152]    	push hl
013B: 6F       [156]    	ld l,a
013C: 3E01     [163]    	ld a,1
013E: 260F     [170]    	ld h,15
0140: 1E24     [177]    	ld e,36
0142: 1600     [184]    	ld d,0
0144: 010000   [194]    	ld bc,0
0147: CDEC08   [211]    	call atSfxPlay
014A: E1       [221]    	pop hl
014B: D1       [231]    	pop de
014C:                   trig_n:
014C: 13       [ 6]     	inc de
014D: 13       [12]     	inc de
014E: 13       [18]     	inc de
014F: C31F01   [28]     	jp trig_l
0152:                   trig_end:
0152: E1       [10]     	pop hl
0153: 3EFF     [17]     	ld a,$FF
0155: D3FF     [28]     	out ($FF),a
0157: 23       [34]     	inc hl
0158: 7C       [38]     	ld a,h
0159: FE18     [45]     	cp 6200/256
015B: C21601   [55|55]  	jp nz,loop
015E: 7D       [59]     	ld a,l
015F: FE38     [66]     	cp 6200 & 255
0161: C21601   [76|76]  	jp nz,loop
0164: 76       [80]     	halt
0165:                   sfx_tab:
0165: 640001            	db 100,0,1
0168: 2C0102            	db 44,1,2
016B: BC0203            	db 188,2,3
016E: B00404            	db 176,4,4
0171: DC0505            	db 220,5,5
0174: E60506            	db 230,5,6
0177: D00707            	db 208,7,7
017A: 280A01            	db 40,10,1
017D: E40C03            	db 228,12,3
0180: 041002            	db 4,16,2
0183: 881305            	db 136,19,5
0186: 701704            	db 112,23,4
0189: 000000            	db 0,0,0
                        #include "../../build/tr/arkos.asm"
                        ;;; arkos_hot.asm — плеер Arkos Tracker 1 для Вектора-06Ц, НАТИВНЫЙ i8080.
                        ;;;
                        ;;; Написан НЕ переводом Z80-исходника, а по исполняемой спецификации tools/arkos_model.py
                        ;;; (она, в свою очередь, сверена побитово с оригиналом ref/msx2/src/ArkosTrackerPlayer_CPC_MSX.asm
                        ;;; на всех 13 песнях по 6200 кадров и на всех 21 эффекте). Формат .mus не менялся.
                        ;;;
                        ;;; Чем отличается от перевода, который тут был раньше:
                        ;;;  * нет эмуляции Z80: ни IX/IY (через ячейки-указатели ps_freqp/ps_volp), ни второго набора
                        ;;;    регистров (exx), ни 16-битных сдвигов по цепочке srl/rr;
                        ;;;  * состояние каналов — плоские структуры в памяти, а не самомодифицируемые операнды;
                        ;;;  * питч трека почти всегда нулевой (93 % каналокадров на песнях игры) — заведён флаг tN_pon,
                        ;;;    и на быстрой ветке сдвиг питча не считается вовсе;
                        ;;;  * таблица периодов разложена на две страничные половины (младшие/старшие байты), выборка
                        ;;;    периода — 5 команд без умножения индекса на 2.
                        ;;;
                        ;;; ЧТО СОЗНАТЕЛЬНО НЕ РЕАЛИЗОВАНО (перепись данных: tools/arkos_model.py --census, гейт
                        ;;; --check-unused падает, если это появится в .mus):
                        ;;;   Software Dependent и Hardware Dependent (аппаратная огибающая, привязанная к тону) —
                        ;;;   в песнях и эффектах Ianna не встречаются ни разу. Ветка помечена ps_h_dependent и просто
                        ;;;   возвращает «звука нет».
                        ;;; Реализовано, хотя встречается редко: Independent (3 раза в эффекте 19, FX_LONGJUMP —
                        ;;; единственное место, где вообще трогаются R11/R12/R13), retrig R13 (в данных не встречается),
                        ;;; дигидрам спец-трека (оригинал пишет его в мёртвую ячейку — здесь просто игнорируется).
                        ;;;
                        ;;; Интерфейс (его зовут music.asm и игра): atInit (DE = адрес песни), atPlay, atStop,
                        ;;; atSfxInit (DE = адрес эффектов), atSfxPlay (A=канал, L=номер, H=громкость, E=нота,
                        ;;; D=скорость, BC=питч), atSfxStopAll, atSfxStop (A=канал). Плюс теневые байты
                        ;;; _atVAR_Reg6/_atVAR_Reg11/_atVAR_Reg12 — их гасит сама игра после MUSIC_Load из LoadScreen.
                        ;;;
                        ;;; Гейты: tests/music/check.sh и tests/music/check_all.py (поток AY 1:1 с Z80-оригиналом),
                        ;;; tools/aydump.py + tools/arkos_model.py --check-game (то же в игре).
                        
00FE:                   _atDEF_R13Retrig	equ $FE		; значение-«замок» R13, заставляющее перезапустить огибающую
0004:                   VI_THR			equ 4		; ВИ53: кадры эффекта тише этой громкости — тишина
                        
                        ;;; ============================== atPlay: один кадр ==============================
018C:                   atPlay:
018C: 3A910A   [13]     	ld a,(at_songctr)
018F: 3D       [17]     	dec a
0190: C29901   [27|27]  	jp nz,ap_keepspeed
0193: CDA105   [44]     	call at_readrow			; линкер, спец-трек, три трека
0196: 3A900A   [57]     	ld a,(at_songspeed)
0199:                   ap_keepspeed:
0199: 32910A   [13]     	ld (at_songctr),a
                        
                        ;;; ------------------------------ канал 3 ------------------------------
019C: 3AF80A   [26]     	ld a,(t3_pon)
019F: B7       [30]     	or a
01A0: C22303   [40|40]  	jp nz,ch3_pslow
01A3: 32A30A   [53]     	ld (ps_pitch),a			; питч канала нулевой (A = 0)
01A6: 32A40A   [66]     	ld (ps_pitch+1),a
01A9:                   ch3_pgo:
01A9: 2AEC0A   [16]     	ld hl,(t3_note)			; L = нота, H = инвертированная громкость
01AC: EB       [20]     	ex de,hl			; D = громкость, E = нота
01AD: 2AEE0A   [36]     	ld hl,(t3_iptr)
01B0: CD4C04   [53]     	call ps_sound
01B3: DABB01   [63|63]  	jp c,ch3_nofreq
01B6: EB       [67]     	ex de,hl
01B7: 22C00A   [83]     	ld (ay_r0+4),hl			; период канала 3 -> R4,R5
01BA: EB       [87]     	ex de,hl
01BB:                   ch3_nofreq:
01BB: 3AA70A   [13]     	ld a,(ps_vol)
01BE: 32C60A   [26]     	ld (ay_r0+10),a			; громкость канала 3 -> R10
01C1: 3AF30A   [39]     	ld a,(t3_ictr)			; шаг инструмента: указатель двигаем только по счётчику
01C4: 3D       [43]     	dec a
01C5: C2CE01   [53|53]  	jp nz,ch3_nofwd
01C8: 22EE0A   [69]     	ld (t3_iptr),hl
01CB: 3AF20A   [82]     	ld a,(t3_ispeed)
01CE:                   ch3_nofwd:
01CE: 32F30A   [13]     	ld (t3_ictr),a
01D1: 3AA70B   [26]     	ld a,(s3_instr+1)		; эффект на канале 3? (адрес всегда >= $D980, хватает старшего байта)
01D4: B7       [30]     	or a
01D5: CA1402   [40|40]  	jp z,ch3_nosfx
01D8: 2AA00B   [56]     	ld hl,(s3_pitch)
01DB: 22A30A   [72]     	ld (ps_pitch),hl
01DE: 2AA20B   [88]     	ld hl,(s3_note)
01E1: EB       [92]     	ex de,hl
01E2: 2AA60B   [108]    	ld hl,(s3_instr)
01E5: 3E01     [115]    	ld a,1
01E7: 32AB0A   [128]    	ld (ps_sfx),a
01EA: CD4C04   [145]    	call ps_sound
01ED: DAF501   [155|155]	jp c,ch3_snofreq
01F0: EB       [159]    	ex de,hl
01F1: 22C00A   [175]    	ld (ay_r0+4),hl
01F4: EB       [179]    	ex de,hl
01F5:                   ch3_snofreq:
01F5: 3AA70A   [13]     	ld a,(ps_vol)
01F8: 32C60A   [26]     	ld (ay_r0+10),a
01FB: AF       [30]     	xor a
01FC: 32AB0A   [43]     	ld (ps_sfx),a
01FF: 7C       [47]     	ld a,h				; адрес 0 = инструмент эффекта кончился
0200: B5       [51]     	or l
0201: CA0B02   [61|61]  	jp z,ch3_ssetinstr
0204: 3AA50B   [74]     	ld a,(s3_sctr)
0207: 3D       [78]     	dec a
0208: C21102   [88|88]  	jp nz,ch3_snofwd
020B:                   ch3_ssetinstr:
020B: 22A60B   [16]     	ld (s3_instr),hl
020E: 3AA40B   [29]     	ld a,(s3_speed)
0211:                   ch3_snofwd:
0211: 32A50B   [13]     	ld (s3_sctr),a
0214:                   ch3_nosfx:
0214: 3AA80A   [13]     	ld a,(ps_ixl)			; регистр 7: биты канала 3 идут на позиции 2
0217: 87       [17]     	add a,a
0218: 87       [21]     	add a,a
0219: 32AA0A   [34]     	ld (ps_r7),a
                        
